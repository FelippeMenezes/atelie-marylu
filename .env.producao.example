# Copie para .env.producao no servidor e preencha. O .env.producao NUNCA vai para o Git.
# Gere senhas fortes com: openssl rand -hex 24
# (evite os caracteres $ ; " nas senhas: o $ é interpretado pelo docker compose e o ; quebra a connection string)

# Endereço principal do site (precisa apontar para o IP do servidor ANTES de subir, para o HTTPS funcionar)
DOMINIO=www.ateliemarylu.com.br
# Endereços que só redirecionam para o principal, separados por espaço (opcional).
# Também precisam apontar para o IP do servidor. Ex.: o domínio sem "www" e o endereço provisório.
DOMINIOS_EXTRAS=ateliemarylu.com.br

# Banco de dados
POSTGRES_DB=atelie_marylu
POSTGRES_USER=atelie
POSTGRES_PASSWORD=

# Primeiro Admin: criado na primeira vez que a loja sobe e obrigado a trocar a senha no primeiro login.
# Depois do primeiro acesso, apague ADMIN_SENHA deste arquivo.
ADMIN_EMAIL=
ADMIN_SENHA=

# Dados legais da loja (rodapé e políticas, exigidos pelo Decreto 7.962/2013)
LOJA_RAZAO_SOCIAL=
LOJA_DOCUMENTO=
LOJA_ENDERECO=Rio de Janeiro - RJ
LOJA_EMAIL=
LOJA_TELEFONE=
# Só números, com DDI 55: 5521999999999
LOJA_WHATSAPP=

# Entrar com Google (opcional; sem as chaves o botão não aparece). Como criar: docs/LOGIN-GOOGLE.md
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Anti-robô do Cloudflare no login/cadastro (opcional; crie em dash.cloudflare.com → Turnstile)
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
