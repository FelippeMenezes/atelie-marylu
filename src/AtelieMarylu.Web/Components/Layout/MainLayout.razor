@inherits LayoutComponentBase

<div class="page">
    <a class="skip-link" href="#conteudo">@L["Skip to content"]</a>
    <Header />

    <main id="conteudo" class="container py-4">
        @Body
    </main>

    <Footer />
    <WhatsAppButton />
</div>

<div id="blazor-error-ui" data-nosnippet>
    @L["An unexpected error occurred."]
    <a href="." class="reload">@L["Reload"]</a>
    <span class="dismiss">🗙</span>
</div>
