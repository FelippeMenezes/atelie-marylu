@using AtelieMarylu.Web.Configuration
@using Microsoft.Extensions.Options
@inject IOptions<ShopOptions> Options
@inject AtelieMarylu.Infrastructure.Integrations.Turnstile Turnstile
@inject IWebHostEnvironment WebHost

@{ var store = Options.Value; }
<footer class="footer">
    <div class="container">
        <div class="row g-3">
            <div class="col-md-5">
                <strong>@store.Name</strong> @L["· Creative sewing"]<br />
                @if (store.HasLegalData)
                {
                    <span>@(string.IsNullOrEmpty(store.LegalName) ? store.Name : store.LegalName) · @store.TaxDocument</span><br />
                }
                @if (!string.IsNullOrEmpty(store.Address))
                {
                    <span>@store.Address</span><br />
                }
                @if (!string.IsNullOrEmpty(store.ContactEmail))
                {
                    <a href="mailto:@store.ContactEmail">@store.ContactEmail</a><br />
                }
                @if (!string.IsNullOrEmpty(store.Phone))
                {
                    <span>@store.Phone</span>
                }
            </div>
            <div class="col-md-4">
                <a href="returns-policy">@L["Exchanges and returns"]</a><br />
                <a href="privacy-policy">@L["Privacy policy"]</a><br />
                <a href="terms-of-use">@L["Terms of use"]</a>
            </div>
            <div class="col-md-3">
                <a href="https://www.instagram.com/@store.Instagram/" target="_blank" rel="noopener">@L["Instagram @{0}", store.Instagram]</a>
            </div>
        </div>
        <p class="small mt-3 mb-0">@L["© {0} {1}. Payments processed in the provider's secure environment.", DateTime.UtcNow.Year, store.Name]</p>
        @* PagBank: aparece sempre, esteja ligado ou não (decisão de 12/11/2026). O logo é o arquivo OFICIAL baixado do
           PagBank (selos para lojistas), salvo em wwwroot/img. Sem o arquivo, aparece o nome em texto.
           O link leva ao trecho da política de privacidade que explica o que vai para o PagBank. *@
        <p class="small mt-1 mb-0 d-flex align-items-center flex-wrap gap-1">
            @* Ícone genérico "lock" do Bootstrap Icons (licença MIT), embutido como o escudo do Turnstile:
               herda a cor do texto e não depende de CDN nem de mudança no CSP *@
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="currentColor" viewBox="0 0 16 16" aria-hidden="true">
                <path d="M8 1a2 2 0 0 1 2 2v4H6V3a2 2 0 0 1 2-2m3 6V3a3 3 0 0 0-6 0v4a2 2 0 0 0-2 2v5a2 2 0 0 0 2 2h6a2 2 0 0 0 2-2V9a2 2 0 0 0-2-2M5 8h6a1 1 0 0 1 1 1v5a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V9a1 1 0 0 1 1-1"/>
            </svg>
            <span>@L["Payments processed by"]</span>
            <a href="privacy-policy#pagbank" class="d-inline-flex align-items-center">
                @if (PagBankLogo is { } logo)
                {
                    <img src="@logo" alt="PagBank" height="20" class="align-text-bottom" />
                }
                else
                {
                    <span>PagBank</span>
                }
            </a>
        </p>
        @if (Turnstile.IsActive)
        {
            @* Só o nome, sem o logo: as regras de marca do Cloudflare exigem autorização por escrito para usar o logo,
               e o selo oficial é para sites que passam pelo CDN dele, o que não é o caso da loja *@
            <p class="small mt-1 mb-0">
                @* Ícone genérico "shield-check" do Bootstrap Icons (licença MIT), embutido para herdar a cor do texto
                   e não depender de CDN nem de mudança no CSP *@
                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="currentColor" viewBox="0 0 16 16" aria-hidden="true" class="align-text-bottom me-1">
                    <path d="M5.338 1.59a61 61 0 0 0-2.837.856.48.48 0 0 0-.328.39c-.554 4.157.726 7.19 2.253 9.188a10.7 10.7 0 0 0 2.287 2.233c.346.244.652.42.893.533q.18.085.293.118a1 1 0 0 0 .101.025 1 1 0 0 0 .1-.025q.114-.034.294-.118c.24-.113.547-.29.893-.533a10.7 10.7 0 0 0 2.287-2.233c1.527-1.997 2.807-5.031 2.253-9.188a.48.48 0 0 0-.328-.39c-.651-.213-1.75-.56-2.837-.855C9.552 1.29 8.531 1.067 8 1.067c-.53 0-1.552.223-2.662.524zM5.072.56C6.157.265 7.31 0 8 0s1.843.265 2.928.56c1.11.3 2.229.655 2.887.87a1.54 1.54 0 0 1 1.044 1.262c.596 4.477-.787 7.795-2.465 9.99a11.8 11.8 0 0 1-2.517 2.453 7 7 0 0 1-1.048.625c-.28.132-.581.24-.829.24s-.548-.108-.829-.24a7 7 0 0 1-1.048-.625 11.8 11.8 0 0 1-2.517-2.453C1.928 10.487.545 7.169 1.141 2.692A1.54 1.54 0 0 1 2.185 1.43 63 63 0 0 1 5.072.56"/>
                    <path d="M10.854 5.146a.5.5 0 0 1 0 .708l-3 3a.5.5 0 0 1-.708 0l-1.5-1.5a.5.5 0 1 1 .708-.708L7.5 7.793l2.646-2.647a.5.5 0 0 1 .708 0"/>
                </svg>@L["Sign-in and registration are protected by"] <a href="privacy-policy#turnstile">Cloudflare Turnstile</a>.
            </p>
        }
    </div>
</footer>

@code {
    // O disco é lido uma vez só por execução (o rodapé aparece em todas as páginas). Um logo novo aparece depois
    // de reiniciar a loja. A troca de referência é atômica, então duas leituras ao mesmo tempo não dão problema.
    private static LogoLookup? logoCache;

    private sealed record LogoLookup(string? Path);

    private string? PagBankLogo => (logoCache ??= new LogoLookup(
        new[] { "img/pagbank.svg", "img/pagbank.png" }.FirstOrDefault(path => WebHost.WebRootFileProvider.GetFileInfo(path).Exists))).Path;
}
