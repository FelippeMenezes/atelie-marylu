@using AtelieMarylu.Web.Configuracao
@using Microsoft.Extensions.Options
@inject IOptions<LojaOptions> Opcoes

@if (Numero is not null)
{
    <a class="whatsapp" href="https://wa.me/@Numero?text=@Uri.EscapeDataString(Mensagem)" target="_blank" rel="noopener" aria-label="Falar no WhatsApp">
        <svg viewBox="0 0 32 32" width="28" height="28" aria-hidden="true" fill="currentColor">
            <path d="M16 3C8.8 3 3 8.7 3 15.8c0 2.5.7 4.9 2 7L3 29l6.4-2c2 1.1 4.3 1.7 6.6 1.7 7.2 0 13-5.7 13-12.8S23.2 3 16 3zm0 23.4c-2.1 0-4.1-.6-5.9-1.6l-.4-.3-3.8 1.2 1.2-3.7-.3-.4c-1.2-1.8-1.8-3.8-1.8-5.9C5 9.9 9.9 5.1 16 5.1s11 4.8 11 10.7-4.9 10.6-11 10.6zm6-7.9c-.3-.2-2-1-2.3-1.1-.3-.1-.5-.2-.8.2-.2.3-.9 1.1-1.1 1.3-.2.2-.4.2-.7.1-.3-.2-1.4-.5-2.7-1.6-1-.9-1.7-2-1.9-2.3-.2-.3 0-.5.1-.7l.5-.6c.2-.2.2-.4.3-.6.1-.2 0-.4 0-.6l-1.1-2.6c-.3-.7-.6-.6-.8-.6h-.7c-.2 0-.6.1-.9.4-.3.3-1.2 1.1-1.2 2.8s1.2 3.2 1.4 3.4c.2.2 2.4 3.6 5.8 5 .8.4 1.4.6 1.9.7.8.3 1.5.2 2.1.1.6-.1 2-.8 2.2-1.6.3-.8.3-1.4.2-1.6-.1-.1-.3-.2-.6-.4z" />
        </svg>
    </a>
}

@code {
    [Parameter] public string Mensagem { get; set; } = "Olá! Vim pelo site do Ateliê Marylu.";

    private string? Numero
    {
        get
        {
            var digitos = new string(Opcoes.Value.WhatsApp.Where(char.IsDigit).ToArray());
            return digitos.Length >= 12 ? digitos : null;
        }
    }
}
