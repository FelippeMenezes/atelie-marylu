@implements IDisposable
@inject CartService Cart

@if (Cart.IsLoaded && !Cart.Current.IsEmpty)
{
    @* O número é só visual; o leitor de tela lê o texto escondido ("Carrinho, 6 itens").
       aria-label num <span> sem papel semântico é ignorado pela maioria dos leitores. *@
    <span class="badge" aria-hidden="true">@Cart.Current.TotalUnits</span>
    <span class="visually-hidden">@(Cart.Current.TotalUnits == 1 ? L["1 item"] : L["{0} items", Cart.Current.TotalUnits])</span>
}

@code {
    protected override void OnInitialized() => Cart.Changed += OnCartChanged;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender) await Cart.LoadAsync();
    }

    private void OnCartChanged() => InvokeAsync(StateHasChanged);

    public void Dispose() => Cart.Changed -= OnCartChanged;
}
