@* Confirmação para a cliente (AML-0040). Com protocolo: solicitação registrada para a equipe responder
   (Decreto 7.962/2013, art. 5º, §4º). Sem protocolo: pedido não pago, cancelado na hora. *@
<EmailLayout Title="@Title" ButtonText="@L["View order"]" Link="@OrderUrl">
    <p style="margin:0 0 16px;">@Greeting</p>
    @if (Protocol is null)
    {
        <p style="margin:0 0 16px;">@L["Order {0} was cancelled on {1}, as you asked. Nothing was charged and you don't need to do anything else.", OrderCode, ReceivedAt]</p>
    }
    else
    {
        <p style="margin:0 0 16px;">@L["We received your request to cancel order {0} on {1}.", OrderCode, ReceivedAt]</p>
        <p style="margin:0 0 16px;">@L["Protocol:"] <strong>@Protocol</strong></p>
        <p style="margin:0 0 16px;">@L["Our team will contact you to arrange the return of the piece, if it has already been sent, and the refund. The refund goes back through the same payment method."]</p>
    }
    <p style="margin:0;">@L["If you did not make this request, reply to this email."]</p>
</EmailLayout>

@code {
    [Parameter] public string? Name { get; set; }
    [Parameter, EditorRequired] public string OrderCode { get; set; } = "";
    [Parameter] public string? Protocol { get; set; }
    [Parameter, EditorRequired] public string ReceivedAt { get; set; } = "";
    [Parameter, EditorRequired] public string OrderUrl { get; set; } = "";

    private string Title => Protocol is null ? L["Order cancelled"] : L["Cancellation request received"];
    private string Greeting => string.IsNullOrWhiteSpace(Name) ? L["Hello!"] : L["Hello, {0}!", Name];
}
