@* E-mail de confirmação: serve para a conta nova e para o e-mail novo de quem pediu a troca.
   O nome é escrito pelo Razor, que codifica o HTML: um nome como <a href=...> aparece como texto. *@
<EmailLayout Title="@L["Confirm your email"]" ButtonText="@L["Confirm email"]" Link="@Link">
    <p style="margin:0 0 16px;">@Greeting</p>
    <p style="margin:0 0 16px;">@L["To confirm this email address in your Ateliê Marylu account, click the button below."]</p>
    <p style="margin:0 0 16px;">@L["This link is valid for {0} hours.", Hours]</p>
    <p style="margin:0;">@L["If you did not ask for this, just ignore this email. Nothing will change in any account."]</p>
</EmailLayout>

@code {
    [Parameter] public string? Name { get; set; }
    [Parameter, EditorRequired] public string Link { get; set; } = "";
    [Parameter, EditorRequired] public int Hours { get; set; }

    private string Greeting => string.IsNullOrWhiteSpace(Name) ? L["Hello!"] : L["Hello, {0}!", Name];
}
