@* Aviso ao dono quando alguém tenta criar uma conta com o e-mail dele. A tela do cadastro não diz
   que o e-mail já existe (evita a enumeração de contas): quem precisa saber é o dono, aqui.
   Não leva link com token: quem quiser trocar a senha pede pelo "Esqueceu sua senha?". Um token gerado
   por um formulário anônimo seria um link sensível disparado por qualquer pessoa. *@
<EmailLayout Title="@L["Someone tried to create an account with your email"]" ButtonText="@L["Forgot your password?"]" Link="@ForgotPasswordUrl">
    <p style="margin:0 0 16px;">@Greeting</p>
    <p style="margin:0 0 16px;">@L["Someone tried to create a new account at Ateliê Marylu with this email, but you already have an account."]</p>
    <p style="margin:0 0 16px;">@L["If it was you, just sign in. If you do not remember your password, use the button below to create a new one."]</p>
    <p style="margin:0;">@L["If it was not you, you can ignore this email: nothing was changed in your account and your password is still the same."]</p>
</EmailLayout>

@code {
    [Parameter] public string? Name { get; set; }
    [Parameter, EditorRequired] public string ForgotPasswordUrl { get; set; } = "";

    private string Greeting => string.IsNullOrWhiteSpace(Name) ? L["Hello!"] : L["Hello, {0}!", Name];
}
