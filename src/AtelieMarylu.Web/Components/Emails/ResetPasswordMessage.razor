@* E-mail do "esqueci minha senha". O nome é escrito pelo Razor, que codifica o HTML. *@
<EmailLayout Title="@L["Create a new password"]" ButtonText="@L["Create a new password"]" Link="@Link">
    <p style="margin:0 0 16px;">@Greeting</p>
    <p style="margin:0 0 16px;">@L["We received a request to create a new password for your Ateliê Marylu account. Click the button below to choose it."]</p>
    <p style="margin:0 0 16px;">@L["This link is valid for {0} hours and can be used only once.", Hours]</p>
    <p style="margin:0;">@L["If you did not ask for this, ignore this email: your password stays the same."]</p>
</EmailLayout>

@code {
    [Parameter] public string? Name { get; set; }
    [Parameter, EditorRequired] public string Link { get; set; } = "";
    [Parameter, EditorRequired] public int Hours { get; set; }

    private string Greeting => string.IsNullOrWhiteSpace(Name) ? L["Hello!"] : L["Hello, {0}!", Name];
}
