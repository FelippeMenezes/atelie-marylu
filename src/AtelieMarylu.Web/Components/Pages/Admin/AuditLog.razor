@page "/admin/audit"
@rendermode InteractiveServer
@attribute [Authorize(Policy = AppRoles.Admin)]
@using AtelieMarylu.Domain.Auditing
@inject AuditService AuditService

<PageTitle>@L["Audit log · Admin"]</PageTitle>

<h1>@L["Audit log"]</h1>
<p class="text-secondary">@L["Record of who did what in the admin and of payment events. It cannot be changed."]</p>

<div class="d-flex gap-2 mb-3 flex-wrap">
    <select class="form-select w-auto" @bind="entity" @bind:after="LoadAsync" aria-label="@L["Filter by type"]">
        <option value="">@L["All"]</option>
        <option value="@AuditEntities.Order">@L["Orders"]</option>
        <option value="@AuditEntities.Product">@L["Products"]</option>
        <option value="@AuditEntities.User">@L["Users"]</option>
        <option value="@AuditEntities.Group">@L["Groups"]</option>
    </select>
    <input class="form-control w-auto" placeholder="@L["Search author or detail"]" @bind="search" @bind:event="oninput" @bind:after="LoadAsync" />
</div>

<div class="table-responsive panel-box p-0">
    <table class="table table-sm align-middle m-0">
        <thead><tr><th>@L["When"]</th><th>@L["Who"]</th><th>@L["Action"]</th><th>@L["Item"]</th><th>@L["Details"]</th></tr></thead>
        <tbody>
            @foreach (var entry in entries)
            {
                <tr class="@(AuditActions.IsPaymentAlert(entry.Action) ? "table-danger" : "")">
                    <td class="text-nowrap">@entry.OccurredAt.FormatBrasilia()</td>
                    <td>@entry.Author</td>
                    <td><code>@entry.Action</code></td>
                    <td>
                        @if (entry.Entity == AuditEntities.Order) { <a href="admin/orders/@entry.EntityId">@L["Order {0}", entry.EntityId]</a> }
                        else if (entry.Entity == AuditEntities.Product) { <a href="admin/products/@entry.EntityId">@L["Product {0}", entry.EntityId]</a> }
                        else { @($"{entry.Entity} {entry.EntityId}") }
                    </td>
                    <td class="small">@entry.Details</td>
                </tr>
            }
        </tbody>
    </table>
</div>

@code {
    private List<AuditEntry> entries = [];
    private string entity = "";
    private string? search;
    private int lastSearch;

    protected override Task OnInitializedAsync() => LoadAsync();

    // Com a busca a cada tecla, uma resposta antiga pode chegar depois da nova: só vale a última
    private async Task LoadAsync()
    {
        var number = ++lastSearch;
        var result = await AuditService.ListAsync(entity, search);
        if (number == lastSearch) entries = result;
    }
}
