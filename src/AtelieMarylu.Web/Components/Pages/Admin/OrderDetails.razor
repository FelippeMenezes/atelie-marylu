@page "/painel/pedidos/{Id:int}"
@rendermode InteractiveServer
@attribute [Authorize(Policy = Permissions.OrdersView)]
@inject CustomerService CustomerService
@inject ProductService ProductService
@inject AuditService AuditService
@inject OrderService Orders
@inject IAuthorizationService Authorization
@inject ILogger<OrderDetails> Logger
@inject OrderEvents Events
@implements IDisposable

<PageTitle>@L["Pedido · Painel"]</PageTitle>

@if (loaded && order is null)
{
    <h1>@L["Pedido não encontrado"]</h1>
}
else if (order is not null)
{
    <h1>@L["Pedido {0}", order.Code]</h1>
    <p>
        <OrderStatusBadge Status="order.Status" />
        <span class="ms-2">@L["Cliente:"] <a href="painel/clientes/@order.CustomerId">@customerName</a></span>
        <span class="text-secondary ms-2">· @order.CreatedAt.FormatBrasilia()</span>
        @if (order.Status == OrderStatus.AwaitingPayment)
        {
            <span class="text-secondary ms-2">@L["· pagar até {0}", order.PayBy.FormatBrasilia()]</span>
        }
    </p>

    <Notice Message="@message" IsError="@isError" />

    @if (canEdit || canCancel)
    {
        <section class="panel-box mb-3">
            <h2 class="h5">@L["Ações"]</h2>
            <div class="d-flex gap-2 flex-wrap align-items-center">
                @if (canEdit && order.Status == OrderStatus.AwaitingPayment)
                {
                    <select class="form-select w-auto" @bind="manualMethod" aria-label="@L["Forma do pagamento manual"]">
                        <option value="@PaymentMethod.Pix">PIX</option>
                        <option value="@PaymentMethod.CreditCard">@L["Cartão"]</option>
                    </select>
                    <button class="btn btn-primary btn-sm" disabled="@processing"
                            @onclick='() => RunActionAsync(() => Orders.RecordManualPaymentAsync(Id, manualMethod), Permissions.OrdersEdit, L["Pagamento registrado."])'>
                        @L["Registrar pagamento recebido"]
                    </button>
                }
                @if (canEdit && order.Status == OrderStatus.Paid)
                {
                    <button class="btn btn-primary btn-sm" disabled="@processing"
                            @onclick='() => RunActionAsync(() => Orders.StartPreparationAsync(Id), Permissions.OrdersEdit, L["Pedido em preparo."])'>
                        @L["Iniciar preparo"]
                    </button>
                }
                @if (canEdit && order.Status is OrderStatus.Paid or OrderStatus.Preparing)
                {
                    <input class="form-control w-auto" placeholder="@L["Código de rastreio"]" @bind="trackingCode" maxlength="50" />
                    <button class="btn btn-primary btn-sm" disabled="@processing"
                            @onclick='() => RunActionAsync(() => Orders.MarkShippedAsync(Id, trackingCode), Permissions.OrdersEdit, L["Pedido marcado como enviado."])'>
                        @L["Marcar como enviado"]
                    </button>
                }
                @if (canEdit && order.Status == OrderStatus.Shipped)
                {
                    <button class="btn btn-primary btn-sm" disabled="@processing"
                            @onclick='() => RunActionAsync(() => Orders.MarkDeliveredAsync(Id), Permissions.OrdersEdit, L["Pedido entregue."])'>
                        @L["Marcar como entregue"]
                    </button>
                }
                @if (canCancel && order.CanCancel)
                {
                    @if (confirmCancellation)
                    {
                        <span>@L["Confirma o cancelamento? O estoque será devolvido."]</span>
                        <input class="form-control form-control-sm w-auto" placeholder="@L["Motivo (opcional)"]" @bind="cancellationReason" maxlength="200" />
                        <button class="btn btn-danger btn-sm" disabled="@processing"
                                @onclick='() => RunActionAsync(() => Orders.CancelAsync(Id, cancellationReason), Permissions.OrdersCancel, L["Pedido cancelado."])'>
                            @L["Sim, cancelar"]
                        </button>
                        <button class="btn btn-link btn-sm" @onclick="() => confirmCancellation = false">@L["Não"]</button>
                    }
                    else
                    {
                        <button class="btn btn-outline-danger btn-sm ms-auto" @onclick="() => confirmCancellation = true">@L["Cancelar pedido"]</button>
                    }
                }
            </div>
            @if (order.Status == OrderStatus.Cancelled && order.Payments.Any(p => p.Status == PaymentStatus.Approved))
            {
                <div class="alert alert-warning mt-3 mb-0">@L["Este pedido tinha pagamento aprovado: faça o estorno no provedor de pagamento."]</div>
            }
        </section>
    }

    @if (canEdit && order.CanChangeItems)
    {
        <section class="panel-box mb-3">
            <h2 class="h5">@L["Editar itens"]</h2>
            @foreach (var item in order.Items)
            {
                <div class="d-flex align-items-center gap-2 py-1 flex-wrap">
                    <span class="flex-grow-1">@item.ProductName (@item.UnitPrice.ToBrl())</span>
                    <input type="number" class="form-control" style="max-width: 90px" min="0" value="@item.Quantity" aria-label="@L["Quantidade"]"
                           @onchange="e => ChangeQuantity(item.ProductId, e.Value)" />
                </div>
            }
            <div class="d-flex gap-2 mt-2 flex-wrap">
                <select class="form-select w-auto" @bind="newProductId" aria-label="@L["Produto para adicionar"]">
                    <option value="0">@L["Adicionar produto..."]</option>
                    @foreach (var p in availableProducts)
                    {
                        <option value="@p.Id">@L["{0} ({1} em estoque)", p.Name, p.Stock]</option>
                    }
                </select>
                <input type="number" class="form-control" style="max-width: 90px" min="1" @bind="newQuantity" aria-label="@L["Quantidade"]" />
                <button class="btn btn-outline-primary btn-sm" disabled="@(processing || newProductId == 0)"
                        @onclick='() => RunActionAsync(() => Orders.AddItemAsync(Id, newProductId, newQuantity), Permissions.OrdersEdit, L["Item adicionado."])'>
                    @L["Adicionar"]
                </button>
            </div>
            <p class="small text-secondary mt-2 mb-0">@L["Zerar a quantidade remove o item. O estoque e o frete são ajustados automaticamente."]</p>
        </section>
    }

    <OrderSummary Order="order" />

    @if (canEdit && order.CanChangeDelivery)
    {
        <section class="panel-box mb-3">
            <h2 class="h5">@L["Editar entrega"]</h2>
            <EditForm Model="address" OnValidSubmit="SaveDeliveryAsync" FormName="delivery">
                <LocalizedDataAnnotationsValidator />
                <AddressFields Address="address" />
                <label class="form-label mt-2" for="obs">@L["Observação"]</label>
                <InputTextArea id="obs" class="form-control" rows="2" @bind-Value="notes" maxlength="500" />
                <button type="submit" class="btn btn-outline-primary btn-sm mt-2" disabled="@processing">@L["Salvar entrega"]</button>
            </EditForm>
        </section>
    }

    <section class="panel-box mb-3">
        <h2 class="h5">@L["Pagamentos"]</h2>
        @if (order.Payments.Count == 0)
        {
            <p class="m-0">@L["Nenhum pagamento iniciado."]</p>
        }
        @foreach (var paymentEntry in order.Payments.OrderByDescending(p => p.CreatedAt))
        {
            <div class="small py-1">
                @paymentEntry.CreatedAt.FormatBrasilia("dd/MM HH:mm") · @(paymentEntry.Method == PaymentMethod.Pix ? "PIX" : L["Cartão"]) ·
                @paymentEntry.Amount.ToBrl() · <strong>@L[Payment.Describe(paymentEntry.Status)]</strong> @L["· via {0}", paymentEntry.Provider]
            </div>
        }
    </section>

    <section class="panel-box mb-3">
        <h2 class="h5">@L["Histórico"]</h2>
        @foreach (var entry in history)
        {
            <div class="small py-1 @(entry.Action == AuditActions.PaymentMismatch ? "text-danger fw-bold" : "")">
                @entry.OccurredAt.FormatBrasilia() · <strong>@entry.Author</strong> · <code>@entry.Action</code> @entry.Details
            </div>
        }
    </section>

    <a href="painel/pedidos">@L["← Voltar para pedidos"]</a>
}

@code {
    [Parameter] public int Id { get; set; }
    [CascadingParameter] private Task<AuthenticationState> AuthState { get; set; } = default!;

    private Order? order;
    private string customerName = "";
    private List<Product> availableProducts = [];
    private AddressForm address = new();
    private string? notes;
    private bool loaded, processing, canEdit, canCancel, confirmCancellation;
    private string? message, trackingCode, cancellationReason;
    private List<AuditEntry> history = [];
    private bool isError;
    private PaymentMethod manualMethod = PaymentMethod.Pix;
    private int newProductId;
    private int newQuantity = 1;

    protected override async Task OnParametersSetAsync()
    {
        canEdit = await HasPermissionAsync(Permissions.OrdersEdit);
        canCancel = await HasPermissionAsync(Permissions.OrdersCancel);
        await LoadAsync();
    }

    // Se o webhook ou outro funcionário mudar o pedido, a tela se atualiza
    protected override void OnInitialized() => Events.OrderChanged += OnOrderChanged;

    private void OnOrderChanged(int orderId)
    {
        if (orderId != Id || processing) return;
        _ = InvokeAsync(async () => { await LoadAsync(); StateHasChanged(); });
    }

    public void Dispose() => Events.OrderChanged -= OnOrderChanged;

    private async Task LoadAsync()
    {
        order = await Orders.GetAsync(Id);
        loaded = true;
        if (order is null) return;

        history = await AuditService.ListForOrderAsync(Id);
        var customer = await CustomerService.GetAsync(order.CustomerId);
        customerName = customer is null ? "?" : $"{customer.FullName} ({customer.Email})";
        address = AddressForm.FromAddress(order.Address);
        notes = order.Notes;
        trackingCode = order.TrackingCode;
        if (canEdit && order.CanChangeItems)
            availableProducts = await ProductService.ListInStockAsync();
    }

    private async Task<bool> HasPermissionAsync(string policy) =>
        (await Authorization.AuthorizeAsync((await AuthState).User, policy)).Succeeded;

    private Task ChangeQuantity(int productId, object? amount) =>
        int.TryParse(amount?.ToString(), out var quantity)
            ? RunActionAsync(() => Orders.ChangeQuantityAsync(Id, productId, quantity), Permissions.OrdersEdit, L["Quantidade alterada."])
            : Task.CompletedTask;

    private Task SaveDeliveryAsync() =>
        RunActionAsync(() => Orders.ChangeDeliveryAsync(Id, address.ToAddress(), notes), Permissions.OrdersEdit, L["Entrega atualizada."]);

    // Toda ação confere a permissão de novo no servidor antes de executar
    private async Task RunActionAsync(Func<Task> action, string permission, string successMessage)
    {
        if (processing) return;
        if (!await HasPermissionAsync(permission))
        {
            (message, isError) = (L["Você não tem permissão para esta ação."], true);
            return;
        }
        processing = true;
        confirmCancellation = false;
        try
        {
            await action();
            (message, isError) = (successMessage, false);
            newProductId = 0;
            newQuantity = 1;
        }
        catch (OrderRuleException ex)
        {
            (message, isError) = (L[ex.Template, ex.Arguments], true);
        }
        catch (InvalidOperationException ex)
        {
            Logger.LogError(ex, "Falha na ação do pedido {PedidoId}", Id);
            (message, isError) = (L["Não foi possível concluir. Tente novamente."], true);
        }
        catch (OperationCanceledException ex)
        {
            Logger.LogError(ex, "Falha na ação do pedido {PedidoId}", Id);
            (message, isError) = (L["Não foi possível concluir. Tente novamente."], true);
        }
        finally
        {
            processing = false;
        }
        await LoadAsync();
    }
}
