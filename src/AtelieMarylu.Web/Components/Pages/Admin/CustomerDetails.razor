@page "/admin/customers/{Id}"
@attribute [Authorize(Policy = Permissions.CustomersView)]
@inject CustomerService CustomerService
@inject OrderService OrderService

<PageTitle>@L["Customer · Admin"]</PageTitle>

@if (loaded && customer is null)
{
    <h1>@L["Customer not found"]</h1>
}
else if (customer is not null)
{
    <h1>@customer.DisplayName</h1>

    <section class="panel-box mb-3">
        <p class="m-0">@L["Email: {0}", customer.Email ?? "—"]</p>
        <p class="m-0">@L["Phone: {0}", customer.Phone ?? "—"]</p>
        <p class="m-0">@L["Customer since: {0}", customer.CreatedAt.FormatBrasilia("dd/MM/yyyy")]</p>
    </section>

    <h2 class="h4">@L["Orders"]</h2>
    @if (orders.Count == 0)
    {
        <p>@L["No orders."]</p>
    }
    else
    {
        <OrdersTable Orders="orders" Link="admin/orders" />
    }
    <p class="mt-3"><a href="admin/customers">@L["← Back to customers"]</a></p>
}

@code {
    [Parameter] public string Id { get; set; } = "";

    private CustomerData? customer;
    private List<Order> orders = [];
    private bool loaded;

    protected override async Task OnParametersSetAsync()
    {
        customer = await CustomerService.GetAsync(Id);
        orders = await OrderService.ListForCustomerAsync(Id);
        loaded = true;
    }
}
