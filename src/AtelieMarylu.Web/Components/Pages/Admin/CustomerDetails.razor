@page "/painel/clientes/{Id}"
@attribute [Authorize(Policy = Permissions.CustomersView)]
@inject CustomerService CustomerService
@inject OrderService OrderService

<PageTitle>@L["Cliente · Painel"]</PageTitle>

@if (loaded && customer is null)
{
    <h1>@L["Cliente não encontrado"]</h1>
}
else if (customer is not null)
{
    <h1>@customer.DisplayName</h1>

    <section class="panel-box mb-3">
        <p class="m-0">@L["E-mail: {0}", customer.Email ?? "—"]</p>
        <p class="m-0">@L["Telefone: {0}", customer.Phone ?? "—"]</p>
        <p class="m-0">@L["Cliente desde: {0}", customer.CreatedAt.FormatBrasilia("dd/MM/yyyy")]</p>
    </section>

    <h2 class="h4">@L["Pedidos"]</h2>
    @if (orders.Count == 0)
    {
        <p>@L["Nenhum pedido."]</p>
    }
    else
    {
        <OrdersTable Orders="orders" Link="painel/pedidos" />
    }
    <p class="mt-3"><a href="painel/clientes">@L["← Voltar para clientes"]</a></p>
}

@code {
    [Parameter] public string Id { get; set; } = "";

    private CustomerData? customer;
    private List<Order> orders = [];
    private bool loaded;

    protected override async Task OnParametersSetAsync()
    {
        customer = await CustomerService.GetAsync(Id);
        orders = await OrderService.ListForCustomerAsync(Id);
        loaded = true;
    }
}
