@page "/admin/customers"
@rendermode InteractiveServer
@attribute [Authorize(Policy = Permissions.CustomersView)]
@inject CustomerService CustomerService

<PageTitle>@L["Customers · Admin"]</PageTitle>

<h1>@L["Customers"]</h1>

<input class="form-control mb-3" style="max-width: 320px" placeholder="@L["Search by name or email"]"
       @bind="search" @bind:event="oninput" @bind:after="LoadAsync" />

@if (customers is null)
{
    <p>@L["Loading..."]</p>
}
else if (customers.Count == 0)
{
    <p>@L["No customers found."]</p>
}
else
{
    <div class="table-responsive panel-box p-0">
        @* A linha inteira abre a cliente (.row-link, regra em app.css) *@
        <table class="table table-fluid align-middle m-0">
            <thead><tr><th>@L["Name"]</th><th>@L["Email"]</th><th>@L["Phone"]</th><th>@L["Signed up"]</th><th class="text-end">@L["Orders"]</th></tr></thead>
            <tbody>
                @foreach (var c in customers)
                {
                    var href = $"admin/customers/{c.Id}";
                    <tr class="row-link">
                        @* Sem nome, o link mostra o e-mail: um link sem texto não tem o que anunciar *@
                        <td><a href="@href" class="row-link-main">@(string.IsNullOrWhiteSpace(c.Name) ? c.Email ?? "—" : c.Name)</a></td>
                        <td class="text-break">@c.Email<CellLink Href="@href" /></td>
                        <td class="text-nowrap">@c.Phone<CellLink Href="@href" /></td>
                        <td>@c.CreatedAt.FormatBrasilia("dd/MM/yyyy")<CellLink Href="@href" /></td>
                        <td class="text-end">@c.Orders<CellLink Href="@href" /></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@code {
    private List<CustomerSummary>? customers;
    private string? search;
    private int lastSearch;

    protected override Task OnInitializedAsync() => LoadAsync();

    // Com a busca a cada tecla, uma resposta antiga pode chegar depois da nova: só vale a última
    private async Task LoadAsync()
    {
        var number = ++lastSearch;
        var result = await CustomerService.ListAsync(search);
        if (number == lastSearch) customers = result;
    }
}
