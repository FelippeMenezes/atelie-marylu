@page "/admin/products"
@attribute [Authorize(Policy = Permissions.ProductsManage)]
@inject ProductService ProductService

<PageTitle>@L["Products · Admin"]</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="m-0">@L["Products"]</h1>
    <a href="admin/products/new" class="btn btn-primary">@L["New product"]</a>
</div>

@* A linha inteira abre o produto (.row-link, regra em app.css). Em tela estreita, a .table-fluid
   encolhe a letra, o espaçamento e a foto para todas as colunas caberem. *@
<div class="table-responsive panel-box p-0">
    <table class="table table-fluid align-middle m-0">
        <thead>
            <tr>
                <th><span class="visually-hidden">@L["Photos"]</span></th>
                <th>@L["Name"]</th>
                <th class="text-end">@L["Price"]</th>
                <th class="text-end">@L["Stock"]</th>
                <th>@L["Status"]</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var p in products)
            {
                var href = $"admin/products/{p.Id}";
                <tr class="row-link">
                    <td class="table-fluid-photo"><ProductPhoto Url="@p.Cover?.ThumbnailUrl" Name="" Class="rounded-2" /><CellLink Href="@href" /></td>
                    <td>
                        <a href="@href" class="row-link-main">@p.Name</a>
                        @if (p.ProductionDays is not null) { <span class="tag ms-1">@L["Made to order"]</span> }
                    </td>
                    <td class="text-end text-nowrap">@p.Price.ToBrl()<CellLink Href="@href" /></td>
                    <td class="text-end @(p.Stock == 0 ? "text-danger fw-bold" : "")">@p.Stock<CellLink Href="@href" /></td>
                    <td>@(p.IsActive ? L["Active"] : L["Inactive"])<CellLink Href="@href" /></td>
                </tr>
            }
        </tbody>
    </table>
</div>

@code {
    private List<Product> products = [];

    protected override async Task OnInitializedAsync()
    {
        products = await ProductService.ListAllAsync();
    }
}
