@page "/admin/orders"
@rendermode InteractiveServer
@attribute [Authorize(Policy = Permissions.OrdersView)]
@inject OrderService OrderService
@inject CustomerService CustomerService
@inject NavigationManager Navigation

<PageTitle>@L["Orders · Admin"]</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
    <h1 class="m-0">@L["Orders"]</h1>
    <AuthorizeView Policy="@Permissions.OrdersCreate">
        <a href="admin/orders/new" class="btn btn-primary">@L["New order"]</a>
    </AuthorizeView>
</div>

<div class="mb-3" style="max-width: 260px">
    <select class="form-select" value="@Status" @onchange="FilterByStatus" aria-label="@L["Filter by status"]">
        <option value="">@L["All statuses"]</option>
        @foreach (var s in Enum.GetValues<OrderStatus>())
        {
            <option value="@s">@L[Order.Describe(s)]</option>
        }
    </select>
</div>

@if (orders is null)
{
    <p>@L["Loading..."]</p>
}
else if (orders.Count == 0)
{
    <p>@L["No orders found."]</p>
}
else
{
    <OrdersTable Orders="orders" Link="admin/orders" CustomerNames="names" />
}

@code {
    [SupplyParameterFromQuery] public string? Status { get; set; }

    private List<Order>? orders;
    private Dictionary<string, string> names = [];

    protected override async Task OnParametersSetAsync()
    {
        OrderStatus? filter = Enum.TryParse<OrderStatus>(Status, out var status) ? status : null;
        orders = await OrderService.ListAsync(filter);
        names = await CustomerService.GetNamesAsync(orders.Select(p => p.CustomerId));
    }

    private void FilterByStatus(ChangeEventArgs e) =>
        Navigation.NavigateTo(Navigation.GetUriWithQueryParameter("status", e.Value?.ToString() is { Length: > 0 } v ? v : null));
}
