@page "/painel/grupos"
@rendermode InteractiveServer
@attribute [Authorize(Policy = AppRoles.Admin)]
@inject AccessService Access

<PageTitle>Grupos · Painel</PageTitle>

<h1>Grupos de funcionários</h1>
<p class="text-secondary">Um grupo reúne permissões. Ao colocar um funcionário no grupo, ele recebe todas de uma vez (ex.: "Expedição" com ver e editar pedidos).</p>

<section class="panel-box mb-3">
    <div class="d-flex gap-2 flex-wrap">
        <input class="form-control w-auto" placeholder="Nome do novo grupo" @bind="newGroup" maxlength="50" />
        <button class="btn btn-primary" @onclick="CreateAsync" disabled="@string.IsNullOrWhiteSpace(newGroup)">Criar grupo</button>
    </div>
</section>

<Notice Message="@message" IsError="@isError" />

@foreach (var g in groups)
{
    var selected = edit[g.Name];
    <section class="panel-box mb-3">
        <div class="d-flex justify-content-between align-items-center">
            <h2 class="h5 m-0">@g.Name <span class="small text-secondary">(@g.Members membro(s))</span></h2>
            @if (deletingGroup == g.Name)
            {
                <span>
                    Excluir o grupo? Os membros perdem estas permissões.
                    <button class="btn btn-danger btn-sm" @onclick="() => Delete(g.Name)">Sim</button>
                    <button class="btn btn-link btn-sm" @onclick="() => deletingGroup = null">Não</button>
                </span>
            }
            else
            {
                <button class="btn btn-outline-danger btn-sm" @onclick="() => deletingGroup = g.Name">Excluir</button>
            }
        </div>
        <div class="mt-2">
            @foreach (var (code, description) in Permissions.All)
            {
                <div class="form-check">
                    <input class="form-check-input" type="checkbox" id="@($"{g.Name}-{code}")" checked="@selected.Contains(code)"
                           @onchange="e => { if (e.Value is true) selected.Add(code); else selected.Remove(code); }" />
                    <label class="form-check-label" for="@($"{g.Name}-{code}")">@description</label>
                </div>
            }
        </div>
        <button class="btn btn-outline-primary btn-sm mt-2" @onclick="() => SaveAsync(g.Name)">Salvar permissões</button>
    </section>
}

@code {
    private IReadOnlyList<GroupSummary> groups = [];
    private Dictionary<string, HashSet<string>> edit = [];
    private string? newGroup, message, deletingGroup;
    private bool isError;

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        groups = await Access.ListGroupsAsync();
        edit = groups.ToDictionary(g => g.Name, g => g.Permissions.ToHashSet());
    }

    private Task CreateAsync() => RunActionAsync(() => Access.CreateGroupAsync(newGroup ?? ""), "Grupo criado.", clearName: true);

    private Task SaveAsync(string name) => RunActionAsync(() => Access.SaveGroupPermissionsAsync(name, edit[name]), $"Permissões de \"{name}\" salvas.");

    private Task Delete(string name) => RunActionAsync(() => Access.DeleteGroupAsync(name), "Grupo excluído.");

    private async Task RunActionAsync(Func<Task> action, string successMessage, bool clearName = false)
    {
        deletingGroup = null;
        try
        {
            await action();
            (message, isError) = (successMessage, false);
            if (clearName) newGroup = null;
        }
        catch (AccessException ex)
        {
            (message, isError) = (ex.Message, true);
        }
        await LoadAsync();
    }
}
