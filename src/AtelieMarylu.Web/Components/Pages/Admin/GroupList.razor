@page "/admin/groups"
@rendermode InteractiveServer
@attribute [Authorize(Policy = AppRoles.Admin)]
@inject AccessService Access

<PageTitle>@L["Groups · Admin"]</PageTitle>

<h1>@L["Employee groups"]</h1>
<p class="text-secondary">@L["A group brings permissions together. When you add an employee to a group, they get all of them at once (e.g. \"Shipping\" with view and edit orders)."]</p>

<section class="panel-box mb-3">
    <div class="d-flex gap-2 flex-wrap">
        <input class="form-control w-auto" placeholder="@L["New group name"]" @bind="newGroup" maxlength="50" />
        <button class="btn btn-primary" @onclick="CreateAsync" disabled="@string.IsNullOrWhiteSpace(newGroup)">@L["Create group"]</button>
    </div>
</section>

<Notice Message="@message" IsError="@isError" />

@foreach (var g in groups)
{
    var selected = edit[g.Name];
    <section class="panel-box mb-3">
        <div class="d-flex justify-content-between align-items-center">
            <h2 class="h5 m-0">@g.Name <span class="small text-secondary">@L["({0} member(s))", g.Members]</span></h2>
            @if (deletingGroup == g.Name)
            {
                <span>
                    @L["Delete the group? Its members lose these permissions."]
                    <button class="btn btn-danger btn-sm" @onclick="() => Delete(g.Name)">@L["Yes"]</button>
                    <button class="btn btn-link btn-sm" @onclick="() => deletingGroup = null">@L["No"]</button>
                </span>
            }
            else
            {
                <button class="btn btn-outline-danger btn-sm" @onclick="() => deletingGroup = g.Name">@L["Delete"]</button>
            }
        </div>
        <div class="mt-2">
            @foreach (var (code, description) in Permissions.All)
            {
                <div class="form-check">
                    <input class="form-check-input" type="checkbox" id="@($"{g.Name}-{code}")" checked="@selected.Contains(code)"
                           @onchange="e => { if (e.Value is true) selected.Add(code); else selected.Remove(code); }" />
                    <label class="form-check-label" for="@($"{g.Name}-{code}")">@L[description]</label>
                </div>
            }
        </div>
        <button class="btn btn-outline-primary btn-sm mt-2" @onclick="() => SaveAsync(g.Name)">@L["Save permissions"]</button>
    </section>
}

@code {
    private IReadOnlyList<GroupSummary> groups = [];
    private Dictionary<string, HashSet<string>> edit = [];
    private string? newGroup, message, deletingGroup;
    private bool isError;

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        groups = await Access.ListGroupsAsync();
        edit = groups.ToDictionary(g => g.Name, g => g.Permissions.ToHashSet());
    }

    private Task CreateAsync() => RunActionAsync(() => Access.CreateGroupAsync(newGroup ?? ""), L["Group created."], clearName: true);

    private Task SaveAsync(string name) => RunActionAsync(() => Access.SaveGroupPermissionsAsync(name, edit[name]), L["Permissions of \"{0}\" saved.", name]);

    private Task Delete(string name) => RunActionAsync(() => Access.DeleteGroupAsync(name), L["Group deleted."]);

    private async Task RunActionAsync(Func<Task> action, string successMessage, bool clearName = false)
    {
        deletingGroup = null;
        try
        {
            await action();
            (message, isError) = (successMessage, false);
            if (clearName) newGroup = null;
        }
        catch (AccessException ex)
        {
            (message, isError) = (L[ex.Message], true);
        }
        await LoadAsync();
    }
}
