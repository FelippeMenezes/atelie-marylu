@page "/admin/products/new"
@page "/admin/products/{Id:int}"
@rendermode InteractiveServer
@attribute [Authorize(Policy = Permissions.ProductsManage)]
@using System.ComponentModel.DataAnnotations
@using System.IO
@inject ProductService ProductService
@inject ImageService Images
@inject NavigationManager Navigation
@inject ILogger<ProductEdit> Logger
@implements IDisposable

<PageTitle>@L["{0} · Admin", Id is null ? L["New product"] : L["Edit product"]]</PageTitle>

<h1>@(Id is null ? L["New product"] : L["Edit product"])</h1>

@if (Id is not null && !found)
{
    <p>@L["Product not found."]</p>
}
else
{
    <EditForm Model="form" OnValidSubmit="SaveAsync" FormName="product">
        <LocalizedDataAnnotationsValidator />
        <div class="panel-box mb-3">
            <div class="row g-3">
                <div class="col-md-8">
                    <label class="form-label" for="nome">@L["Name"]</label>
                    <InputText id="nome" class="form-control" @bind-Value="form.Name" />
                    <ValidationMessage For="() => form.Name" />
                </div>
                <div class="col-md-4">
                    <label class="form-label" for="preco">@L["Price (R$)"]</label>
                    <InputNumber id="preco" class="form-control" @bind-Value="form.Price" step="0.01" />
                    <ValidationMessage For="() => form.Price" />
                </div>
                <div class="col-12">
                    <label class="form-label" for="descricao">@L["Description (include sizes and materials)"]</label>
                    <InputTextArea id="descricao" class="form-control" rows="5" @bind-Value="form.Description" />
                    <ValidationMessage For="() => form.Description" />
                </div>
                <div class="col-md-3">
                    <label class="form-label" for="estoque">@L["Stock"]</label>
                    <InputNumber id="estoque" class="form-control" @bind-Value="form.Stock" />
                    <ValidationMessage For="() => form.Stock" />
                </div>
                <div class="col-md-4">
                    <label class="form-label" for="prazo">@L["Production time (business days)"]</label>
                    <InputNumber id="prazo" class="form-control" @bind-Value="form.ProductionDays" placeholder="@L["Empty = ready to ship"]" />
                    <ValidationMessage For="() => form.ProductionDays" />
                </div>
                <div class="col-md-5 d-flex align-items-end">
                    <div class="form-check">
                        <InputCheckbox id="ativo" class="form-check-input" @bind-Value="form.IsActive" />
                        <label class="form-check-label" for="ativo">@L["Active (shown in the store)"]</label>
                    </div>
                </div>
            </div>
        </div>

        <div class="panel-box mb-3">
            <h2 class="h5">@L["Photos"]</h2>
            <p class="small text-secondary">@L["The first photo is the cover. Photos are resized, converted to WEBP and have their location (GPS) data removed."]</p>
            <div class="d-flex gap-3 flex-wrap mb-3">
                @for (var i = 0; i < photos.Count; i++)
                {
                    var index = i;
                    var photo = photos[i];
                    <div style="width: 130px">
                        <ProductPhoto Url="@photo.ThumbnailUrl" Name="@form.Name" Class="rounded-3" />
                        <div class="d-flex justify-content-between mt-1">
                            <button type="button" class="btn btn-link btn-sm p-0" disabled="@(index == 0)" @onclick="() => Move(index, -1)" aria-label="@L["Move left"]">◀</button>
                            <button type="button" class="btn btn-link btn-sm p-0 text-danger" @onclick="() => Remove(index)">@L["Remove"]</button>
                            <button type="button" class="btn btn-link btn-sm p-0" disabled="@(index == photos.Count - 1)" @onclick="() => Move(index, 1)" aria-label="@L["Move right"]">▶</button>
                        </div>
                        @if (index == 0) { <div class="small text-center tag d-block">@L["Cover"]</div> }
                    </div>
                }
            </div>
            <InputFile OnChange="UploadPhotosAsync" multiple accept="image/jpeg,image/png,image/webp" class="form-control" disabled="@uploading" />
            <div class="small text-secondary mt-1">@(uploading ? L["Processing photos..."] : L["JPG, PNG or WEBP, up to 8 MB each, {0} photos at most.", MaxPhotos])</div>
        </div>

        <div class="panel-box mb-3">
            <h2 class="h5">@L["Packaging (for shipping calculation)"]</h2>
            <div class="row g-3">
                <div class="col-6 col-md-3">
                    <label class="form-label" for="peso">@L["Weight (g)"]</label>
                    <InputNumber id="peso" class="form-control" @bind-Value="form.WeightGrams" />
                    <ValidationMessage For="() => form.WeightGrams" />
                </div>
                <div class="col-6 col-md-3">
                    <label class="form-label" for="altura">@L["Height (cm)"]</label>
                    <InputNumber id="altura" class="form-control" @bind-Value="form.HeightCm" />
                    <ValidationMessage For="() => form.HeightCm" />
                </div>
                <div class="col-6 col-md-3">
                    <label class="form-label" for="largura">@L["Width (cm)"]</label>
                    <InputNumber id="largura" class="form-control" @bind-Value="form.WidthCm" />
                    <ValidationMessage For="() => form.WidthCm" />
                </div>
                <div class="col-6 col-md-3">
                    <label class="form-label" for="comprimento">@L["Length (cm)"]</label>
                    <InputNumber id="comprimento" class="form-control" @bind-Value="form.LengthCm" />
                    <ValidationMessage For="() => form.LengthCm" />
                </div>
            </div>
        </div>

        <Notice Message="@message" IsError="@isError" />

        <div class="d-flex gap-2">
            <button type="submit" class="btn btn-primary" disabled="@(saving || uploading)">@L["Save"]</button>
            <a href="admin/products" class="btn btn-outline-primary">@L["Back"]</a>
            @if (Id is not null && form.IsActive)
            {
                <a href="@($"product/{Id}")" target="_blank" class="btn btn-link ms-auto">@L["View in store"]</a>
            }
        </div>
    </EditForm>
}

@code {
    private const int MaxPhotos = 8;

    [Parameter] public int? Id { get; set; }

    private ProductForm form = new();
    private List<SavedImage> photos = [];
    // Fotos removidas só têm o arquivo apagado depois de salvar (se cancelar, nada se perde)
    private readonly List<SavedImage> removedPhotos = [];
    private readonly List<SavedImage> newPhotos = [];
    private int stockWhenOpened;
    private bool found, saving, uploading, isError;
    private string? message;

    protected override Task OnParametersSetAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        if (Id is null) return;
        var p = await ProductService.GetAsync(Id.Value);
        found = p is not null;
        if (p is null) return;

        form = new ProductForm
        {
            Name = p.Name, Description = p.Description, Price = p.Price, Stock = p.Stock, IsActive = p.IsActive, ProductionDays = p.ProductionDays,
            WeightGrams = p.WeightGrams, HeightCm = p.HeightCm, WidthCm = p.WidthCm, LengthCm = p.LengthCm,
        };
        stockWhenOpened = p.Stock;
        photos = p.Images.OrderBy(i => i.SortOrder).Select(i => new SavedImage(i.Url, i.ThumbnailUrl)).ToList();
    }

    private async Task UploadPhotosAsync(InputFileChangeEventArgs e)
    {
        uploading = true;
        message = null;
        try
        {
            foreach (var file in e.GetMultipleFiles(MaxPhotos))
            {
                if (photos.Count >= MaxPhotos)
                {
                    (message, isError) = (L["Limit of {0} photos.", MaxPhotos], true);
                    break;
                }
                var saved = await Images.SaveAsync(file);
                photos.Add(saved);
                newPhotos.Add(saved);
            }
            if (!isError) (message, isError) = (L["Photos added. Click Save to confirm."], false);
        }
        catch (InvalidOperationException ex)
        {
            (message, isError) = (L[ex.Message], true);
        }
        catch (IOException ex)
        {
            Logger.LogWarning(ex, "Falha no upload de imagem");
            (message, isError) = (L["Could not upload the photo (8 MB maximum)."], true);
        }
        finally
        {
            uploading = false;
        }
    }

    private void Move(int index, int direction)
    {
        var target = index + direction;
        if (target < 0 || target >= photos.Count) return;
        (photos[index], photos[target]) = (photos[target], photos[index]);
    }

    private void Remove(int index)
    {
        removedPhotos.Add(photos[index]);
        photos.RemoveAt(index);
    }

    private async Task SaveAsync()
    {
        saving = true;
        try
        {
            var data = new ProductInput(form.Name, form.Description, form.Price, form.Stock, form.IsActive, form.ProductionDays,
                form.WeightGrams, form.HeightCm, form.WidthCm, form.LengthCm, stockWhenOpened);
            var productId = await ProductService.SaveAsync(Id, data, photos);
            if (productId is null) { (message, isError) = (L["Product not found."], true); return; }

            Images.Delete(removedPhotos.SelectMany(f => new[] { f.Url, f.ThumbnailUrl }).ToArray());
            removedPhotos.Clear();
            newPhotos.Clear();

            if (Id is null)
            {
                Navigation.NavigateTo($"admin/products/{productId}");
                return;
            }
            await LoadAsync();
            (message, isError) = (L["Product saved."], false);
        }
        catch (ProductRuleException ex)
        {
            (message, isError) = (L[ex.Message], true);
        }
        catch (InvalidOperationException ex)
        {
            Logger.LogError(ex, "Falha ao salvar o produto {ProdutoId}", Id);
            (message, isError) = (L["Could not save. Try again."], true);
        }
        catch (IOException ex)
        {
            Logger.LogError(ex, "Falha ao salvar o produto {ProdutoId}", Id);
            (message, isError) = (L["Could not save. Try again."], true);
        }
        finally
        {
            saving = false;
        }
    }

    // Fotos enviadas e nunca salvas não têm registro no banco: apaga ao sair da página
    public void Dispose()
    {
        if (newPhotos.Count > 0)
            Images.Delete(newPhotos.SelectMany(f => new[] { f.Url, f.ThumbnailUrl }).ToArray());
    }

    private sealed class ProductForm
    {
        [Required(ErrorMessage = "Enter the name."), StringLength(120)]
        public string Name { get; set; } = "";

        [StringLength(2000)]
        public string Description { get; set; } = "";

        // Os limites estão escritos com ponto: sem ParseLimitsInInvariantCulture, a cultura pt-BR
        // (que usa vírgula) não consegue ler "0.01" e a validação derruba a página ao digitar o preço
        [Range(typeof(decimal), "0.01", "99999", ErrorMessage = "Invalid price.", ParseLimitsInInvariantCulture = true)]
        public decimal Price { get; set; }

        [Range(0, 100000, ErrorMessage = "Invalid stock.")]
        public int Stock { get; set; }

        [Range(1, 120, ErrorMessage = "Between 1 and 120 days.")]
        public int? ProductionDays { get; set; }

        public bool IsActive { get; set; } = true;

        [Range(1, 30000, ErrorMessage = "Between 1 g and 30 kg.")]
        public int WeightGrams { get; set; } = 300;

        [Range(1, 100, ErrorMessage = "Between 1 and 100 cm.")]
        public int HeightCm { get; set; } = 5;

        [Range(1, 100, ErrorMessage = "Between 1 and 100 cm.")]
        public int WidthCm { get; set; } = 20;

        [Range(1, 100, ErrorMessage = "Between 1 and 100 cm.")]
        public int LengthCm { get; set; } = 25;
    }
}
