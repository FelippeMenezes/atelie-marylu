@page "/painel/produtos/novo"
@page "/painel/produtos/{Id:int}"
@rendermode InteractiveServer
@attribute [Authorize(Policy = Permissions.ProductsManage)]
@using System.ComponentModel.DataAnnotations
@using System.IO
@inject ProductService ProductService
@inject ImageService Images
@inject NavigationManager Navigation
@inject ILogger<ProductEdit> Logger
@implements IDisposable

<PageTitle>@(Id is null ? "Novo produto" : "Editar produto") · Painel</PageTitle>

<h1>@(Id is null ? "Novo produto" : "Editar produto")</h1>

@if (Id is not null && !found)
{
    <p>Produto não encontrado.</p>
}
else
{
    <EditForm Model="form" OnValidSubmit="SaveAsync" FormName="product">
        <DataAnnotationsValidator />
        <div class="panel-box mb-3">
            <div class="row g-3">
                <div class="col-md-8">
                    <label class="form-label" for="nome">Nome</label>
                    <InputText id="nome" class="form-control" @bind-Value="form.Name" />
                    <ValidationMessage For="() => form.Name" />
                </div>
                <div class="col-md-4">
                    <label class="form-label" for="preco">Preço (R$)</label>
                    <InputNumber id="preco" class="form-control" @bind-Value="form.Price" step="0.01" />
                    <ValidationMessage For="() => form.Price" />
                </div>
                <div class="col-12">
                    <label class="form-label" for="descricao">Descrição (inclua medidas e materiais)</label>
                    <InputTextArea id="descricao" class="form-control" rows="5" @bind-Value="form.Description" />
                    <ValidationMessage For="() => form.Description" />
                </div>
                <div class="col-md-3">
                    <label class="form-label" for="estoque">Estoque</label>
                    <InputNumber id="estoque" class="form-control" @bind-Value="form.Stock" />
                    <ValidationMessage For="() => form.Stock" />
                </div>
                <div class="col-md-4">
                    <label class="form-label" for="prazo">Prazo de produção (dias úteis)</label>
                    <InputNumber id="prazo" class="form-control" @bind-Value="form.ProductionDays" placeholder="Vazio = pronta entrega" />
                    <ValidationMessage For="() => form.ProductionDays" />
                </div>
                <div class="col-md-5 d-flex align-items-end">
                    <div class="form-check">
                        <InputCheckbox id="ativo" class="form-check-input" @bind-Value="form.IsActive" />
                        <label class="form-check-label" for="ativo">Ativo (aparece na loja)</label>
                    </div>
                </div>
            </div>
        </div>

        <div class="panel-box mb-3">
            <h2 class="h5">Fotos</h2>
            <p class="small text-secondary">A primeira foto é a capa. As fotos são reduzidas, convertidas para WEBP e têm os dados de localização (GPS) removidos.</p>
            <div class="d-flex gap-3 flex-wrap mb-3">
                @for (var i = 0; i < photos.Count; i++)
                {
                    var index = i;
                    var photo = photos[i];
                    <div style="width: 130px">
                        <ProductPhoto Url="@photo.ThumbnailUrl" Name="@form.Name" Class="rounded-3" />
                        <div class="d-flex justify-content-between mt-1">
                            <button type="button" class="btn btn-link btn-sm p-0" disabled="@(index == 0)" @onclick="() => Move(index, -1)" aria-label="Mover para a esquerda">◀</button>
                            <button type="button" class="btn btn-link btn-sm p-0 text-danger" @onclick="() => Remove(index)">Remover</button>
                            <button type="button" class="btn btn-link btn-sm p-0" disabled="@(index == photos.Count - 1)" @onclick="() => Move(index, 1)" aria-label="Mover para a direita">▶</button>
                        </div>
                        @if (index == 0) { <div class="small text-center tag d-block">Capa</div> }
                    </div>
                }
            </div>
            <InputFile OnChange="UploadPhotosAsync" multiple accept="image/jpeg,image/png,image/webp" class="form-control" disabled="@uploading" />
            <div class="small text-secondary mt-1">@(uploading ? "Processando fotos..." : $"JPG, PNG ou WEBP, até 8 MB cada, no máximo {MaxPhotos} fotos.")</div>
        </div>

        <div class="panel-box mb-3">
            <h2 class="h5">Embalagem (para cálculo de frete)</h2>
            <div class="row g-3">
                <div class="col-6 col-md-3">
                    <label class="form-label" for="peso">Peso (g)</label>
                    <InputNumber id="peso" class="form-control" @bind-Value="form.WeightGrams" />
                    <ValidationMessage For="() => form.WeightGrams" />
                </div>
                <div class="col-6 col-md-3">
                    <label class="form-label" for="altura">Altura (cm)</label>
                    <InputNumber id="altura" class="form-control" @bind-Value="form.HeightCm" />
                    <ValidationMessage For="() => form.HeightCm" />
                </div>
                <div class="col-6 col-md-3">
                    <label class="form-label" for="largura">Largura (cm)</label>
                    <InputNumber id="largura" class="form-control" @bind-Value="form.WidthCm" />
                    <ValidationMessage For="() => form.WidthCm" />
                </div>
                <div class="col-6 col-md-3">
                    <label class="form-label" for="comprimento">Comprimento (cm)</label>
                    <InputNumber id="comprimento" class="form-control" @bind-Value="form.LengthCm" />
                    <ValidationMessage For="() => form.LengthCm" />
                </div>
            </div>
        </div>

        <Notice Message="@message" IsError="@isError" />

        <div class="d-flex gap-2">
            <button type="submit" class="btn btn-primary" disabled="@(saving || uploading)">Salvar</button>
            <a href="painel/produtos" class="btn btn-outline-primary">Voltar</a>
            @if (Id is not null && form.IsActive)
            {
                <a href="@($"produto/{Id}")" target="_blank" class="btn btn-link ms-auto">Ver na loja</a>
            }
        </div>
    </EditForm>
}

@code {
    private const int MaxPhotos = 8;

    [Parameter] public int? Id { get; set; }

    private ProductForm form = new();
    private List<SavedImage> photos = [];
    // Fotos removidas só têm o arquivo apagado depois de salvar (se cancelar, nada se perde)
    private readonly List<SavedImage> removedPhotos = [];
    private readonly List<SavedImage> newPhotos = [];
    private int stockWhenOpened;
    private bool found, saving, uploading, isError;
    private string? message;

    protected override Task OnParametersSetAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        if (Id is null) return;
        var p = await ProductService.GetAsync(Id.Value);
        found = p is not null;
        if (p is null) return;

        form = new ProductForm
        {
            Name = p.Name, Description = p.Description, Price = p.Price, Stock = p.Stock, IsActive = p.IsActive, ProductionDays = p.ProductionDays,
            WeightGrams = p.WeightGrams, HeightCm = p.HeightCm, WidthCm = p.WidthCm, LengthCm = p.LengthCm,
        };
        stockWhenOpened = p.Stock;
        photos = p.Images.OrderBy(i => i.SortOrder).Select(i => new SavedImage(i.Url, i.ThumbnailUrl)).ToList();
    }

    private async Task UploadPhotosAsync(InputFileChangeEventArgs e)
    {
        uploading = true;
        message = null;
        try
        {
            foreach (var file in e.GetMultipleFiles(MaxPhotos))
            {
                if (photos.Count >= MaxPhotos)
                {
                    (message, isError) = ($"Limite de {MaxPhotos} fotos.", true);
                    break;
                }
                var saved = await Images.SaveAsync(file);
                photos.Add(saved);
                newPhotos.Add(saved);
            }
            if (!isError) (message, isError) = ("Fotos adicionadas. Clique em Salvar para confirmar.", false);
        }
        catch (InvalidOperationException ex)
        {
            (message, isError) = (ex.Message, true);
        }
        catch (IOException ex)
        {
            Logger.LogWarning(ex, "Falha no upload de imagem");
            (message, isError) = ("Não foi possível enviar a foto (máximo 8 MB).", true);
        }
        finally
        {
            uploading = false;
        }
    }

    private void Move(int index, int direction)
    {
        var target = index + direction;
        if (target < 0 || target >= photos.Count) return;
        (photos[index], photos[target]) = (photos[target], photos[index]);
    }

    private void Remove(int index)
    {
        removedPhotos.Add(photos[index]);
        photos.RemoveAt(index);
    }

    private async Task SaveAsync()
    {
        saving = true;
        try
        {
            var data = new ProductInput(form.Name, form.Description, form.Price, form.Stock, form.IsActive, form.ProductionDays,
                form.WeightGrams, form.HeightCm, form.WidthCm, form.LengthCm, stockWhenOpened);
            var productId = await ProductService.SaveAsync(Id, data, photos);
            if (productId is null) { (message, isError) = ("Produto não encontrado.", true); return; }

            Images.Delete(removedPhotos.SelectMany(f => new[] { f.Url, f.ThumbnailUrl }).ToArray());
            removedPhotos.Clear();
            newPhotos.Clear();

            if (Id is null)
            {
                Navigation.NavigateTo($"painel/produtos/{productId}");
                return;
            }
            await LoadAsync();
            (message, isError) = ("Produto salvo.", false);
        }
        catch (ProductRuleException ex)
        {
            (message, isError) = (ex.Message, true);
        }
        catch (InvalidOperationException ex)
        {
            Logger.LogError(ex, "Falha ao salvar o produto {ProdutoId}", Id);
            (message, isError) = ("Não foi possível salvar. Tente novamente.", true);
        }
        catch (IOException ex)
        {
            Logger.LogError(ex, "Falha ao salvar o produto {ProdutoId}", Id);
            (message, isError) = ("Não foi possível salvar. Tente novamente.", true);
        }
        finally
        {
            saving = false;
        }
    }

    // Fotos enviadas e nunca salvas não têm registro no banco: apaga ao sair da página
    public void Dispose()
    {
        if (newPhotos.Count > 0)
            Images.Delete(newPhotos.SelectMany(f => new[] { f.Url, f.ThumbnailUrl }).ToArray());
    }

    private sealed class ProductForm
    {
        [Required(ErrorMessage = "Informe o nome."), StringLength(120)]
        public string Name { get; set; } = "";

        [StringLength(2000)]
        public string Description { get; set; } = "";

        // Os limites estão escritos com ponto: sem ParseLimitsInInvariantCulture, a cultura pt-BR
        // (que usa vírgula) não consegue ler "0.01" e a validação derruba a página ao digitar o preço
        [Range(typeof(decimal), "0.01", "99999", ErrorMessage = "Preço inválido.", ParseLimitsInInvariantCulture = true)]
        public decimal Price { get; set; }

        [Range(0, 100000, ErrorMessage = "Estoque inválido.")]
        public int Stock { get; set; }

        [Range(1, 120, ErrorMessage = "Entre 1 e 120 dias.")]
        public int? ProductionDays { get; set; }

        public bool IsActive { get; set; } = true;

        [Range(1, 30000, ErrorMessage = "Entre 1 g e 30 kg.")]
        public int WeightGrams { get; set; } = 300;

        [Range(1, 100, ErrorMessage = "Entre 1 e 100 cm.")]
        public int HeightCm { get; set; } = 5;

        [Range(1, 100, ErrorMessage = "Entre 1 e 100 cm.")]
        public int WidthCm { get; set; } = 20;

        [Range(1, 100, ErrorMessage = "Entre 1 e 100 cm.")]
        public int LengthCm { get; set; } = 25;
    }
}
