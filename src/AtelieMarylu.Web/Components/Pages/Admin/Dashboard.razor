@page "/painel"
@inject DashboardService Painel

<PageTitle>Painel · Ateliê Marylu</PageTitle>

<h1>Painel</h1>

<AuthorizeView Policy="@Permissions.OrdersView">
    @if (alerts.Count > 0)
    {
        <section class="alert alert-danger">
            <h2 class="h5">Pagamentos que precisam de atenção</h2>
            <p class="small">Pagamentos aprovados em pedidos cancelados ou com valor diferente. Verifique e, se for o caso, estorne no provedor.</p>
            <ul class="mb-0">
                @foreach (var a in alerts)
                {
                    <li><a href="painel/pedidos/@a.EntityId">@a.OccurredAt.FormatBrasilia()</a>: @a.Details</li>
                }
            </ul>
        </section>
    }
</AuthorizeView>

<div class="row g-3">
    <AuthorizeView Policy="@Permissions.OrdersView">
        <div class="col-sm-6">
            <a href="painel/pedidos?status=@OrderStatus.Paid" class="panel-box d-block text-decoration-none">
                <div class="fs-2 fw-bold">@paid</div>
                Pedidos pagos aguardando preparo
            </a>
        </div>
        <div class="col-sm-6">
            <a href="painel/pedidos?status=@OrderStatus.AwaitingPayment" class="panel-box d-block text-decoration-none">
                <div class="fs-2 fw-bold">@awaitingPayment</div>
                Pedidos aguardando pagamento
            </a>
        </div>
    </AuthorizeView>
    <AuthorizeView Policy="@Permissions.ProductsManage">
        <div class="col-sm-6">
            <a href="painel/produtos" class="panel-box d-block text-decoration-none">
                <div class="fs-2 fw-bold">@outOfStock</div>
                Produtos ativos esgotados
            </a>
        </div>
    </AuthorizeView>
</div>

@code {
    private int paid, awaitingPayment, outOfStock;
    private IReadOnlyList<AuditEntry> alerts = [];

    protected override async Task OnInitializedAsync()
    {
        // São só contagens; cada tela de destino confere a permissão de novo
        var summary = await Painel.GetSummaryAsync();
        (paid, awaitingPayment, outOfStock, alerts) = (summary.Paid, summary.AwaitingPayment, summary.OutOfStock, summary.Alerts);
    }
}
