@page "/admin"
@inject DashboardService Painel

<PageTitle>@L["Admin · Ateliê Marylu"]</PageTitle>

<h1>@L["Admin panel"]</h1>

<AuthorizeView Policy="@Permissions.OrdersView">
    @if (alerts.Count > 0)
    {
        <section class="alert alert-danger">
            <h2 class="h5">@L["Payments that need attention"]</h2>
            <p class="small">@L["Payments approved on cancelled orders or with a different amount. Check them and, if needed, refund at the provider."]</p>
            <ul class="mb-0">
                @foreach (var a in alerts)
                {
                    <li><a href="admin/orders/@a.EntityId">@a.OccurredAt.FormatBrasilia()</a>: @a.Details</li>
                }
            </ul>
        </section>
    }
</AuthorizeView>

<div class="row g-3">
    <AuthorizeView Policy="@Permissions.OrdersView">
        <div class="col-sm-6">
            <a href="admin/orders?status=@OrderStatus.Paid" class="panel-box d-block text-decoration-none">
                <div class="fs-2 fw-bold">@paid</div>
                @L["Paid orders awaiting preparation"]
            </a>
        </div>
        <div class="col-sm-6">
            <a href="admin/orders?status=@OrderStatus.AwaitingPayment" class="panel-box d-block text-decoration-none">
                <div class="fs-2 fw-bold">@awaitingPayment</div>
                @L["Orders awaiting payment"]
            </a>
        </div>
    </AuthorizeView>
    <AuthorizeView Policy="@Permissions.ProductsManage">
        <div class="col-sm-6">
            <a href="admin/products" class="panel-box d-block text-decoration-none">
                <div class="fs-2 fw-bold">@outOfStock</div>
                @L["Active products sold out"]
            </a>
        </div>
    </AuthorizeView>
</div>

@code {
    private int paid, awaitingPayment, outOfStock;
    private IReadOnlyList<AuditEntry> alerts = [];

    protected override async Task OnInitializedAsync()
    {
        // São só contagens; cada tela de destino confere a permissão de novo
        var summary = await Painel.GetSummaryAsync();
        (paid, awaitingPayment, outOfStock, alerts) = (summary.Paid, summary.AwaitingPayment, summary.OutOfStock, summary.Alerts);
    }
}
