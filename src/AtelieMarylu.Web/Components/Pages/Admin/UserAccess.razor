@page "/admin/users/{Id}"
@rendermode InteractiveServer
@attribute [Authorize(Policy = AppRoles.Admin)]
@using System.Security.Claims
@inject AccessService Access
@inject CustomerService CustomerService
@using Microsoft.AspNetCore.Identity

<PageTitle>@L["Access · Admin"]</PageTitle>

@if (user is null)
{
    <p>@(loaded ? L["User not found."] : L["Loading..."])</p>
}
else
{
    <h1>@user.DisplayName</h1>
    <p class="text-secondary">@user.Email</p>

    <section class="panel-box mb-3">
        <div class="form-check">
            <input class="form-check-input" type="checkbox" id="admin" @bind="isAdmin" disabled="@(Id == myId)" />
            <label class="form-check-label" for="admin"><strong>@L["Admin"]</strong>@L[": full access, including users and groups"]</label>
        </div>
        @if (Id == myId)
        {
            <div class="small text-secondary">@L["You cannot remove your own Admin access."]</div>
        }
    </section>

    <section class="panel-box mb-3">
        <h2 class="h5">@L["Groups"]</h2>
        @if (groups.Count == 0)
        {
            <p class="m-0">@L["No groups created."] <a href="admin/groups">@L["Create groups"]</a></p>
        }
        @foreach (var g in groups)
        {
            <div class="form-check">
                <input class="form-check-input" type="checkbox" id="g-@g.Name" checked="@selectedGroups.Contains(g.Name)"
                       @onchange="e => Toggle(selectedGroups, g.Name, e)" />
                <label class="form-check-label" for="g-@g.Name">
                    @g.Name <span class="small text-secondary">(@string.Join(", ", g.Permissions.Select(p => L[Permissions.All.GetValueOrDefault(p, p)].Value)))</span>
                </label>
            </div>
        }
    </section>

    <section class="panel-box mb-3">
        <h2 class="h5">@L["Individual permissions"]</h2>
        <p class="small text-secondary">@L["Added to the group permissions."]</p>
        @foreach (var (permissionKey, description) in Permissions.All)
        {
            <div class="form-check">
                <input class="form-check-input" type="checkbox" id="p-@permissionKey" checked="@selectedPermissions.Contains(permissionKey)"
                       @onchange="e => Toggle(selectedPermissions, permissionKey, e)" />
                <label class="form-check-label" for="p-@permissionKey">@L[description]</label>
            </div>
        }
    </section>

    <Notice Message="@message" IsError="@isError" />

    <button class="btn btn-primary" @onclick="SaveAsync" disabled="@saving">@L["Save access"]</button>
    <a href="admin/users" class="btn btn-outline-primary">@L["Back"]</a>
    <p class="small text-secondary mt-2">@L["The person must sign in again for the changes to take effect."]</p>

    <section class="panel-box mt-4">
        <h2 class="h5">@L["Password"]</h2>
        @if (Id == myId)
        {
            <p class="m-0">@L["To change your own password, use"] <a href="Account/Manage/ChangePassword">@L["Change password"]</a>.</p>
        }
        else if (temporaryPassword is not null)
        {
            @* Mostrada uma única vez: ao sair da tela, ela some e não fica guardada em lugar nenhum *@
            <div class="alert alert-success" role="status">
                <p class="mb-1">@L["Temporary password:"] <code class="fs-5 user-select-all">@temporaryPassword</code></p>
                <p class="small m-0">@L["Send it to the person privately. It will not be shown again, and they must create a new password at the next sign-in."]</p>
            </div>
        }
        else
        {
            <p class="small text-secondary">@L["Creates a temporary password and signs the person out of all devices. They must create a new password at the next sign-in."]</p>
            <Notice Message="@resetMessage" IsError="true" />
            @if (confirmingReset)
            {
                <button class="btn btn-danger" @onclick="ResetPasswordAsync" disabled="@saving">@L["Confirm password reset"]</button>
                <button class="btn btn-outline-secondary" @onclick="() => confirmingReset = false" disabled="@saving">@L["Cancel"]</button>
            }
            else
            {
                <button class="btn btn-outline-danger" @onclick="() => confirmingReset = true">@L["Reset password"]</button>
            }
        }
    </section>
}

@code {
    [Parameter] public string Id { get; set; } = "";
    [CascadingParameter] private Task<AuthenticationState> AuthState { get; set; } = default!;

    private CustomerData? user;
    private IReadOnlyList<GroupSummary> groups = [];
    private HashSet<string> selectedGroups = [];
    private HashSet<string> selectedPermissions = [];
    private bool isAdmin, loaded, saving, isError;
    private string? message;
    private string myId = "";
    private bool confirmingReset;
    private string? temporaryPassword, resetMessage;

    protected override async Task OnParametersSetAsync()
    {
        myId = (await AuthState).User.FindFirstValue(ClaimTypes.NameIdentifier) ?? "";
        user = await CustomerService.GetAsync(Id);
        loaded = true;
        if (user is null) return;

        groups = await Access.ListGroupsAsync();
        var access = await Access.GetAccessAsync(Id);
        isAdmin = access.IsAdmin;
        selectedGroups = access.Groups.ToHashSet();
        selectedPermissions = access.IndividualPermissions.ToHashSet();
    }

    private static void Toggle(HashSet<string> conjunto, string amount, ChangeEventArgs e)
    {
        if (e.Value is true) conjunto.Add(amount);
        else conjunto.Remove(amount);
    }

    private async Task ResetPasswordAsync()
    {
        saving = true;
        resetMessage = null;
        try
        {
            temporaryPassword = await Access.ResetPasswordAsync(Id, myId);
        }
        catch (AccessException ex)
        {
            resetMessage = L[ex.Message];
        }
        finally
        {
            (saving, confirmingReset) = (false, false);
        }
    }

    private async Task SaveAsync()
    {
        saving = true;
        try
        {
            await Access.SaveAccessAsync(Id, myId, new UserAccessData(isAdmin, selectedGroups.ToList(), selectedPermissions.ToList()));
            (message, isError) = (L["Access saved."], false);
        }
        catch (AccessException ex)
        {
            (message, isError) = (L[ex.Message], true);
        }
        finally
        {
            saving = false;
        }
    }
}
