@page "/my-orders/{Code}"
@rendermode InteractiveServer
@attribute [Authorize]
@implements IDisposable
@using System.Security.Claims
@using AtelieMarylu.Infrastructure.Integrations
@using AtelieMarylu.Web.Configuration
@inject OrderService Orders
@inject OrderEvents Events
@inject IWebHostEnvironment Environment
@inject ILogger<MyOrder> Logger

<PageTitle>@L["Order {0} · Ateliê Marylu", Code]</PageTitle>

@if (loaded && order is null)
{
    <h1>@L["Order not found"]</h1>
    <a href="my-orders">@L["Back to my orders"]</a>
}
else if (order is not null)
{
    @if (New == 1 && order.Status == OrderStatus.AwaitingPayment)
    {
        <div class="alert alert-success">
            <strong>@L["Order received!"]</strong> @L["Now just pay and we'll start preparing your order."]
        </div>
    }

    <h1>@L["Order {0}", order.Code]</h1>
    <p>
        <OrderStatusBadge Status="order.Status" />
        <span class="text-secondary ms-2">@L["placed on {0}", order.CreatedAt.FormatBrasilia()]</span>
    </p>

    <Notice Message="@message" IsError="@isError" />

    @if (order.Status == OrderStatus.Paid)
    {
        <div class="alert alert-success">@L["Payment confirmed! We'll prepare your order and let you know when it ships."]</div>
    }

    @if (order.Status == OrderStatus.AwaitingPayment)
    {
        <section class="panel-box mb-3">
            <h2 class="h5">@L["Payment"]</h2>
            <p class="small">@L["Pay by"] <strong>@order.PayBy.FormatBrasilia()</strong>@L[". After that, the order is cancelled automatically."]</p>

            @if (PendingPayment is { } paymentEntry)
            {
                @if (paymentEntry.Method == PaymentMethod.Pix && paymentEntry.PixCopyPaste is not null)
                {
                    <PixPayment Code="@paymentEntry.PixCopyPaste" Amount="paymentEntry.Amount" />
                }
                else if (paymentEntry.PaymentUrl is not null)
                {
                    <a class="btn btn-primary" href="@paymentEntry.PaymentUrl" target="_blank" rel="noopener">@L["Pay with card ({0})", paymentEntry.Amount.ToBrl()]</a>
                }
                else
                {
                    <p>@L["Card payment started ({0}). As soon as the provider confirms, this page will update by itself.", paymentEntry.Amount.ToBrl()]</p>
                }
            }
            else
            {
                <p>@L["Choose how to pay:"]</p>
            }

            <div class="d-flex gap-2 flex-wrap mt-3">
                @if (PendingPayment?.Method != PaymentMethod.Pix)
                {
                    <button class="btn btn-outline-primary btn-sm" @onclick="() => NewPaymentAsync(PaymentMethod.Pix)" disabled="@processing">
                        @L["Pay with PIX ({0})", order.AmountFor(PaymentMethod.Pix).ToBrl()]
                    </button>
                }
                @if (PendingPayment?.Method != PaymentMethod.CreditCard)
                {
                    <button class="btn btn-outline-primary btn-sm" @onclick="() => NewPaymentAsync(PaymentMethod.CreditCard)" disabled="@processing">
                        @L["Pay with card ({0})", order.AmountFor(PaymentMethod.CreditCard).ToBrl()]
                    </button>
                }
            </div>

            @if (Environment.IsDevelopment() && PendingPayment is { Provider: SimulatedPaymentGateway.ProviderName } simulated)
            {
                <div class="alert alert-warning mt-3 mb-0">
                    <strong>@L["Development environment:"]</strong> @L["payment is simulated."]
                    <button class="btn btn-sm btn-warning ms-2" @onclick="() => SimulateApprovalAsync(simulated)" disabled="@processing">@L["Simulate approved payment"]</button>
                </div>
            }
        </section>
    }

    <OrderSummary Order="order" />
    <p class="small">@L["Questions about your order? Message us on WhatsApp or Instagram with the code"] <strong>@order.Code</strong>.</p>
    <a href="my-orders">@L["← Back to my orders"]</a>
}

@code {
    [Parameter] public string Code { get; set; } = "";
    [SupplyParameterFromQuery] public int? New { get; set; }
    [CascadingParameter] private Task<AuthenticationState> AuthState { get; set; } = default!;

    private Order? order;
    private bool loaded, processing, isError;
    private string? message;

    private Payment? PendingPayment => order?.Payments
        .Where(p => p.Status == PaymentStatus.Pending)
        .OrderByDescending(p => p.CreatedAt)
        .FirstOrDefault();

    // Quando o webhook confirma o pagamento, a página se atualiza sem o cliente recarregar
    protected override void OnInitialized() => Events.OrderChanged += OnOrderChanged;

    protected override Task OnParametersSetAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        var customerId = (await AuthState).User.FindFirstValue(ClaimTypes.NameIdentifier);
        order = await Orders.GetForCustomerAsync(Code, customerId);
        loaded = true;
    }

    private void OnOrderChanged(int orderId)
    {
        if (orderId != order?.Id) return;
        _ = InvokeAsync(async () =>
        {
            await LoadAsync();
            StateHasChanged();
        });
    }

    private async Task NewPaymentAsync(PaymentMethod method)
    {
        if (order is null || processing) return;
        await RunActionAsync(() => Orders.StartPaymentAsync(order.Id, method), null);
    }

    private async Task SimulateApprovalAsync(Payment payment)
    {
        if (!Environment.IsDevelopment() || payment.ExternalId is null) return;
        // Mesmo caminho que o webhook do provedor real vai usar
        await RunActionAsync(() => Orders.ProcessNotificationAsync(
            new PaymentNotification($"{payment.ExternalId}:Approved", payment.ExternalId, PaymentStatus.Approved, payment.Amount)), null);
    }

    private async Task RunActionAsync(Func<Task> action, string? successMessage)
    {
        processing = true;
        message = null;
        try
        {
            await action();
            if (successMessage is not null) (message, isError) = (successMessage, false);
        }
        catch (OrderRuleException ex)
        {
            (message, isError) = (L.Translate(ex), true);
        }
        catch (OperationCanceledException)
        {
            throw;
        }
        catch (InvalidOperationException ex)
        {
            // Registra o Id interno, não o código digitado na URL (evita "log injection")
            Logger.LogError(ex, "Falha na ação do pedido {PedidoId}", order?.Id);
            (message, isError) = (L["Could not complete. Try again."], true);
        }
        finally
        {
            processing = false;
        }
        await LoadAsync();
    }

    public void Dispose() => Events.OrderChanged -= OnOrderChanged;
}
