@page "/my-orders/{Code}"
@rendermode InteractiveServer
@attribute [Authorize]
@implements IDisposable
@using System.Security.Claims
@using AtelieMarylu.Infrastructure.Integrations
@using AtelieMarylu.Web.Configuration
@inject OrderService Orders
@inject OrderEvents Events
@inject IWebHostEnvironment Environment
@inject ILogger<MyOrder> Logger
@inject Microsoft.Extensions.Options.IOptions<ShopOptions> Store
@inject TimeProvider Clock

<PageTitle>@L["Order {0} · Ateliê Marylu", Code]</PageTitle>

@if (loaded && order is null)
{
    <h1>@L["Order not found"]</h1>
    <a href="my-orders">@L["Back to my orders"]</a>
}
else if (order is not null)
{
    @if (New == 1 && order.Status == OrderStatus.AwaitingPayment)
    {
        <div class="alert alert-success">
            <strong>@L["Order received!"]</strong> @L["Now just pay and we'll start preparing your order."]
        </div>
    }

    <h1>@L["Order {0}", order.Code]</h1>
    <p>
        <OrderStatusBadge Status="order.Status" />
        <span class="text-secondary ms-2">@L["placed on {0}", order.CreatedAt.FormatBrasilia()]</span>
    </p>

    <Notice Message="@message" IsError="@isError" />

    @* Com cancelamento pedido, "vamos preparar seu pedido" contradiria a caixa do protocolo logo abaixo *@
    @if (order.Status == OrderStatus.Paid && order.PendingCancellationRequest is null)
    {
        <div class="alert alert-success">@L["Payment confirmed! We'll prepare your order and let you know when it ships."]</div>
    }

    @if (order.Status == OrderStatus.AwaitingPayment)
    {
        <section class="panel-box mb-3">
            <h2 class="h5">@L["Payment"]</h2>
            <p class="small">@L["Pay by"] <strong>@order.PayBy.FormatBrasilia()</strong>@L[". After that, the order is cancelled automatically."]</p>

            @if (OpenPayment is { } paymentEntry)
            {
                @if (paymentEntry.Method == PaymentMethod.Pix && paymentEntry.PixCopyPaste is not null)
                {
                    <PixPayment Code="@paymentEntry.PixCopyPaste" Amount="paymentEntry.Amount" />
                }
                else if (paymentEntry.PaymentUrl is not null)
                {
                    @* Abre a página segura do PagBank em outra aba. Esta continua aberta e se atualiza sozinha quando o pagamento for confirmado. *@
                    <a class="btn btn-primary" href="@paymentEntry.PaymentUrl" target="_blank" rel="noopener noreferrer">@L["Pay on PagBank ({0})", paymentEntry.Amount.ToBrl()]</a>
                    <p class="small text-muted mt-2">@L["The payment opens on PagBank's secure page. This page updates by itself when the payment is confirmed."]</p>
                }
                else
                {
                    <p>@L["Payment started ({0}). As soon as the provider confirms, this page will update by itself.", paymentEntry.Amount.ToBrl()]</p>
                }
            }
            else if (OpeningPayment is not null)
            {
                @* A chamada ao provedor ainda está em andamento (ex.: em outra aba): a página se atualiza quando ela terminar *@
                <p role="status">@L["Opening the payment… This page will update by itself."]</p>
            }
            else if (NotOpenedAttempt is { } failed)
            {
                @* A última tentativa não abriu no provedor: diz isso com clareza e oferece repetir a mesma forma *@
                <div class="alert alert-warning" role="alert">
                    <strong>@L["The payment did not open."]</strong> @L["Nothing was charged. Try again or choose another way to pay."]
                </div>
                <button class="btn btn-primary" @onclick="() => NewPaymentAsync(failed.Method)" disabled="@processing">
                    @(failed.Method == PaymentMethod.Pix
                        ? L["Try PIX again ({0})", order.AmountFor(PaymentMethod.Pix).ToBrl()]
                        : L["Try card again ({0})", order.AmountFor(PaymentMethod.CreditCard).ToBrl()])
                </button>
            }
            else
            {
                <p>@L["Choose how to pay:"]</p>
            }

            <div class="d-flex gap-2 flex-wrap mt-3">
                @if (ShowsMethodButton(PaymentMethod.Pix))
                {
                    <button class="btn btn-outline-primary btn-sm" @onclick="() => NewPaymentAsync(PaymentMethod.Pix)" disabled="@processing">
                        @L["Pay with PIX ({0})", order.AmountFor(PaymentMethod.Pix).ToBrl()]
                    </button>
                }
                @if (ShowsMethodButton(PaymentMethod.CreditCard))
                {
                    <button class="btn btn-outline-primary btn-sm" @onclick="() => NewPaymentAsync(PaymentMethod.CreditCard)" disabled="@processing">
                        @L["Pay with card ({0})", order.AmountFor(PaymentMethod.CreditCard).ToBrl()]
                    </button>
                }
            </div>

            @if (Environment.IsDevelopment() && OpenPayment is { Provider: SimulatedPaymentGateway.ProviderName } simulated)
            {
                <div class="alert alert-warning mt-3 mb-0">
                    <strong>@L["Development environment:"]</strong> @L["payment is simulated."]
                    <button class="btn btn-sm btn-warning ms-2" @onclick="() => SimulateApprovalAsync(simulated)" disabled="@processing">@L["Simulate approved payment"]</button>
                </div>
            }
        </section>
    }

    @* Convite de avaliação no Google: só depois que a peça saiu (é quando a cliente tem algo a avaliar).
       Avaliações pesam muito na busca local ("ateliê de costura perto de mim"). *@
    @if ((order.Status is OrderStatus.Shipped or OrderStatus.Delivered) && Store.Value.HasReviewLink)
    {
        <div class="alert alert-light d-flex flex-wrap align-items-center gap-2">
            <span>@L["Liked your piece? A review on Google helps our studio a lot."]</span>
            <a class="btn btn-outline-primary btn-sm" href="@Store.Value.GoogleReviewUrl" target="_blank" rel="noopener noreferrer">@L["Review us on Google"]</a>
        </div>
    }

    @* Cancelamento e desistência pelo próprio site (Decreto 7.962/2013, art. 5º, AML-0040). Não pago: cancela na hora.
       Pago: vira uma solicitação para a equipe, que combina a devolução e faz o estorno. *@
    @if (order.PendingCancellationRequest is { } pending)
    {
        <div class="alert alert-info" role="status">
            <strong>@L["Cancellation request received."]</strong>
            @L["Protocol {0}, sent on {1}. Our team will contact you to arrange the refund.", pending.Protocol, pending.RequestedAt.FormatBrasilia()]
        </div>
    }
    else if (order.Status == OrderStatus.AwaitingPayment || order.CanRequestCancellation(Now))
    {
        var unpaid = order.Status == OrderStatus.AwaitingPayment;
        <section class="panel-box mb-3" aria-labelledby="cancelar-titulo">
            <h2 class="h5" id="cancelar-titulo">@(unpaid ? L["Cancel order"] : L["Cancel or return"])</h2>
            <p class="small">
                @if (unpaid)
                {
                    @L["The order has not been paid yet. Cancelling releases the pieces and nothing is charged."]
                }
                else if (order.Status == OrderStatus.Shipped)
                {
                    @L["You can withdraw from the purchase within 7 days of receiving it, without giving a reason. We arrange the return at no cost to you and refund the full amount, including shipping."]
                    <a href="returns-policy">@L["See the exchanges and returns policy"]</a>
                }
                else if (order.Status == OrderStatus.Delivered)
                {
                    @* A loja não guarda a data em que a cliente recebeu a peça: o texto não promete nem nega o prazo de 7 dias.
                       A equipe avalia ao responder (desistência, troca ou defeito). *@
                    @L["Want to withdraw, exchange or report a defect? Send a request and our team will contact you."]
                    <a href="returns-policy">@L["See the exchanges and returns policy"]</a>
                }
                else
                {
                    @L["Your request goes to our team, who will cancel the order and refund the full amount through the same payment method."]
                }
            </p>
            @if (!confirmingCancellation)
            {
                <button class="btn btn-outline-danger btn-sm" @onclick="() => confirmingCancellation = true">
                    @(unpaid ? L["Cancel order"] : L["Request cancellation"])
                </button>
            }
            else
            {
                @* Motivo só na solicitação: no pedido não pago, um texto livre ficaria no pedido guardado por obrigação fiscal *@
                @if (!unpaid)
                {
                    <label for="cancelar-motivo" class="form-label small">@L["Reason (optional)"]</label>
                    <textarea id="cancelar-motivo" class="form-control" rows="3" maxlength="@CancellationRequest.ReasonMaxLength" @bind="cancellationReason"></textarea>
                }
                <div class="d-flex gap-2 mt-2 flex-wrap">
                    <button class="btn btn-danger btn-sm" @onclick="RequestCancellationAsync" disabled="@processing">
                        @(unpaid ? L["Yes, cancel the order"] : L["Send cancellation request"])
                    </button>
                    <button class="btn btn-link btn-sm" @onclick="() => confirmingCancellation = false" disabled="@processing">@L["Back"]</button>
                </div>
            }
        </section>
    }

    <OrderSummary Order="order" />
    <p class="small">@L["Questions about your order? Message us on WhatsApp or Instagram with the code"] <strong>@order.Code</strong>.</p>
    <a href="my-orders">@L["← Back to my orders"]</a>
}

@code {
    [Parameter] public string Code { get; set; } = "";
    [SupplyParameterFromQuery] public int? New { get; set; }
    [CascadingParameter] private Task<AuthenticationState> AuthState { get; set; } = default!;

    private Order? order;
    private bool loaded, processing, isError, confirmingCancellation;
    private string? message, cancellationReason;

    // A última tentativa de pagamento (o Id cresce a cada uma; mais confiável que comparar horários)
    private Payment? LatestPayment => order?.Payments.MaxBy(p => p.Id);

    private DateTime Now => Clock.GetUtcNow().UtcDateTime;

    // Cobrança aberta no provedor: tem link ou código PIX para a cliente pagar
    private Payment? OpenPayment => LatestPayment is { Status: PaymentStatus.Pending, HasStarted: true } p ? p : null;

    // A chamada ao provedor ainda pode estar em andamento: nada de "Tentar de novo" para essa forma
    private Payment? OpeningPayment => LatestPayment is { } p && p.IsOpening(Now) ? p : null;

    // A última tentativa não chegou a abrir (regra em Payment.DidNotOpen)
    private Payment? NotOpenedAttempt => LatestPayment is { } p && p.DidNotOpen(Now) ? p : null;

    // Esconde o botão da forma que já está na tela: aberta, abrindo ou com o próprio "Tentar de novo"
    private bool ShowsMethodButton(PaymentMethod method) =>
        (OpenPayment ?? OpeningPayment ?? NotOpenedAttempt)?.Method != method;

    // Quando o webhook confirma o pagamento, a página se atualiza sem o cliente recarregar
    protected override void OnInitialized() => Events.OrderChanged += OnOrderChanged;

    protected override Task OnParametersSetAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        var customerId = (await AuthState).User.FindFirstValue(ClaimTypes.NameIdentifier);
        order = await Orders.GetForCustomerAsync(Code, customerId);
        loaded = true;
    }

    private void OnOrderChanged(int orderId)
    {
        if (orderId != order?.Id) return;
        _ = InvokeAsync(async () =>
        {
            await LoadAsync();
            StateHasChanged();
        });
    }

    private async Task NewPaymentAsync(PaymentMethod method)
    {
        if (order is null || processing) return;
        await RunActionAsync(() => Orders.StartPaymentAsync(order.Id, method), null);
    }

    private async Task RequestCancellationAsync()
    {
        if (order is null || processing) return;
        var customerId = (await AuthState).User.FindFirstValue(ClaimTypes.NameIdentifier);
        if (customerId is null) return;
        var reason = order.Status == OrderStatus.AwaitingPayment ? null : cancellationReason;
        CancellationOutcome? outcome = null;
        await RunActionAsync(async () => outcome = await Orders.RequestCancellationAsync(order.Code, customerId, reason), null);
        if (outcome is null) return;
        (confirmingCancellation, cancellationReason) = (false, null);
        // A solicitação já aparece na caixa com o protocolo: uma mensagem de sucesso em cima só repetiria o aviso
        (message, isError) = (outcome.CancelledNow ? L["Order cancelled."].Value : null, false);
        // Os e-mails de confirmação foram gravados na outbox junto com a solicitação e saem em segundo plano (AML-0041)
    }

    private async Task SimulateApprovalAsync(Payment payment)
    {
        if (!Environment.IsDevelopment() || payment.ExternalId is null) return;
        // Mesmo caminho que o webhook do provedor real vai usar
        await RunActionAsync(() => Orders.ProcessNotificationAsync(
            new PaymentNotification($"{payment.ExternalId}:Approved", payment.ExternalId, PaymentStatus.Approved, payment.Amount)), null);
    }

    private async Task RunActionAsync(Func<Task> action, string? successMessage)
    {
        var gatewayFailed = false;
        processing = true;
        message = null;
        try
        {
            await action();
            if (successMessage is not null) (message, isError) = (successMessage, false);
        }
        catch (OrderRuleException ex)
        {
            (message, isError) = (L.Translate(ex), true);
        }
        catch (OperationCanceledException)
        {
            throw;
        }
        catch (PaymentGatewayException ex)
        {
            Logger.LogError(ex, "Falha no provedor de pagamento no pedido {PedidoId}", order?.Id);
            (message, isError) = (L["Could not start the payment right now. Try again in a few minutes."], true);
            gatewayFailed = true;
        }
        catch (InvalidOperationException ex)
        {
            // Registra o Id interno, não o código digitado na URL (evita "log injection")
            Logger.LogError(ex, "Falha na ação do pedido {PedidoId}", order?.Id);
            (message, isError) = (L["Could not complete. Try again."], true);
        }
        finally
        {
            processing = false;
        }
        await LoadAsync();
        // A caixa "o pagamento não abriu" já explica a falha: a mensagem de cima repetiria o mesmo aviso.
        // Ela continua quando a falha foi outra (ex.: não deu para fechar a cobrança anterior no provedor).
        if (gatewayFailed && NotOpenedAttempt is not null) message = null;
    }

    public void Dispose() => Events.OrderChanged -= OnOrderChanged;
}
