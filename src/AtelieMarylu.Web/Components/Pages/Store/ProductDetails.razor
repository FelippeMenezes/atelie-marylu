@page "/product/{Id:int}"
@page "/product/{Id:int}/{Slug}"
@using System.Text.Json
@inject ProductService ProductService
@inject NavigationManager Navigation

@* Página estática (rápida e indexável). Só "adicionar ao carrinho" e "calcular frete" são ilhas interativas. *@
@if (product is null)
{
    <PageTitle>@L["Product not found"]</PageTitle>
    <h1>@L["Product not found"]</h1>
    <a href="">@L["Back to the store"]</a>
}
else
{
    var productUrl = $"{Navigation.BaseUri}{product.Url}";
    var image = product.Cover is { } cover ? $"{Navigation.BaseUri.TrimEnd('/')}{cover.Url}" : $"{Navigation.BaseUri}img/logo.png";
    var summary = product.Description.Length > 160 ? product.Description[..157] + "..." : product.Description;

    <PageTitle>@L["{0} · Ateliê Marylu", product.Name]</PageTitle>
    <HeadContent>
        <meta name="description" content="@summary" />
        <link rel="canonical" href="@productUrl" />
        @* Open Graph: a prévia com foto quando o link é compartilhado no Instagram/WhatsApp *@
        <meta property="og:type" content="product" />
        <meta property="og:title" content="@product.Name" />
        <meta property="og:description" content="@summary" />
        <meta property="og:image" content="@image" />
        <meta property="og:url" content="@productUrl" />
        <meta property="product:price:amount" content="@product.Price.ToString(System.Globalization.CultureInfo.InvariantCulture)" />
        <meta property="product:price:currency" content="BRL" />
        @* Dados estruturados: o Google pode mostrar preço e disponibilidade na busca *@
        @((MarkupString)$"<script type=\"application/ld+json\">{StructuredData(productUrl, image)}</script>")
    </HeadContent>

    <nav aria-label="@L["Navigation"]" class="small mb-3"><a href="">@L["Store"]</a> › @product.Name</nav>

    <div class="row g-4">
        <div class="col-md-6">
            @if (product.Images.Count == 0)
            {
                <ProductPhoto Name="@product.Name" Class="rounded-4" />
            }
            else
            {
                var photos = product.Images.OrderBy(i => i.SortOrder).ToList();
                <div class="gallery" tabindex="0" aria-label="@L["Product photos"]">
                    @for (var i = 0; i < photos.Count; i++)
                    {
                        <img id="foto-@i" class="product-photo" src="@photos[i].Url" alt="@L["{0}, photo {1} of {2}", product.Name, i + 1, photos.Count]" loading="@(i == 0 ? "eager" : "lazy")" />
                    }
                </div>
                @if (photos.Count > 1)
                {
                    <div class="gallery-thumbs">
                        @for (var i = 0; i < photos.Count; i++)
                        {
                            <a href="@($"{product.Url}#foto-{i}")" aria-label="@L["View photo {0}", i + 1]"><img class="product-photo rounded-2" src="@photos[i].ThumbnailUrl" alt="" /></a>
                        }
                    </div>
                }
            }
        </div>
        <div class="col-md-6">
            <h1>@product.Name</h1>
            <ProductPrice Price="product.Price" Large="true" />

            <p class="mt-3" style="white-space: pre-line">@product.Description</p>

            <p class="small">
                @if (product.ProductionDays is int days)
                {
                    <strong>@L["Made to order:"]</strong> <text>@L["made within {0} business days after payment confirmation, plus shipping time.", days]</text>
                }
                else
                {
                    <strong>@L["Ready to ship:"]</strong> <text>@L["we ship within 2 business days after payment confirmation."]</text>
                }
                <br /><span class="text-secondary">@L["Handmade piece: small variations in cut and print are part of its charm."]</span>
            </p>

            @if (product.IsAvailableForSale)
            {
                @if (product.Stock <= 2)
                {
                    <p class="tag mb-2">@L["Last {0} unit(s)", product.Stock]</p>
                }
                <AddToCart @rendermode="InteractiveServer" ProductId="product.Id" Stock="product.Stock" />
            }
            else
            {
                <div class="alert alert-secondary">@L["Sold out for now. Message us on WhatsApp or Instagram to order one."]</div>
            }

            <div class="mt-3">
                <ShippingCalculator @rendermode="InteractiveServer" ProductId="product.Id" />
            </div>
            <p class="small mt-3"><a href="returns-policy">@L["Exchanges and returns"]</a> @L["· 7 days to withdraw from the purchase."]</p>
        </div>
    </div>
}

@code {
    [Parameter] public int Id { get; set; }
    [Parameter] public string? Slug { get; set; }

    private Product? product;

    protected override async Task OnParametersSetAsync()
    {
        product = await ProductService.GetActiveAsync(Id);

        // Produto inexistente responde 404 (página "não encontrada"), para o Google não indexar páginas vazias
        if (product is null)
        {
            Navigation.NotFound();
            return;
        }

        // URL canônica com o nome do produto (melhor para SEO e para quem recebe o link)
        if (Slug != product.Slug)
            Navigation.NavigateTo(product.Url, replace: true);
    }

    private string StructuredData(string url, string image)
    {
        var data = new Dictionary<string, object>
        {
            ["@context"] = "https://schema.org",
            ["@type"] = "Product",
            ["name"] = product!.Name,
            ["description"] = product.Description,
            ["image"] = image,
            ["url"] = url,
            ["offers"] = new Dictionary<string, object>
            {
                ["@type"] = "Offer",
                ["price"] = product.Price,
                ["priceCurrency"] = "BRL",
                ["availability"] = product.IsAvailableForSale ? "https://schema.org/InStock" : "https://schema.org/OutOfStock",
            },
        };
        // O encoder padrão escapa <, > e & — impede que um texto do produto feche a tag <script>
        return JsonSerializer.Serialize(data);
    }
}
