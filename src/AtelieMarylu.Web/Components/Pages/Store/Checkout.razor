@page "/checkout"
@rendermode InteractiveServer
@attribute [Authorize]
@using System.Security.Claims
@using AtelieMarylu.Domain.Shipping
@using AtelieMarylu.Web.Configuration
@using Microsoft.Extensions.Options
@inject ProductService ProductService
@inject CartService Cart
@inject OrderService Orders
@inject NavigationManager Navigation
@inject IOptions<ShopOptions> Store
@inject ILogger<Checkout> Logger

<PageTitle>@L["Checkout · Ateliê Marylu"]</PageTitle>

<h1>@L["Checkout"]</h1>

@if (!ready)
{
    <div class="skeleton" style="height: 300px"></div>
}
else if (Cart.Current.IsEmpty)
{
    <p>@L["Your cart is empty."]</p>
    <a href="" class="btn btn-primary">@L["View products"]</a>
}
else
{
    <EditForm Model="address" OnValidSubmit="FinishAsync" FormName="checkout">
        <LocalizedDataAnnotationsValidator />
        <div class="row g-4">
            <div class="col-lg-7">
                <section class="panel-box mb-3">
                    <h2 class="h4">@L["1. Delivery address"]</h2>
                    <AddressFields Address="address" OnPostalCodeChanged="ClearShipping" />
                </section>

                <section class="panel-box mb-3">
                    <h2 class="h4">@L["2. Shipping"]</h2>
                    @if (shippingOptions is null)
                    {
                        <button type="button" class="btn btn-outline-primary" @onclick="CalculateShippingAsync" disabled="@processing">@L["Calculate shipping"]</button>
                    }
                    else
                    {
                        <InputRadioGroup @bind-Value="shippingCode">
                            @foreach (var o in shippingOptions)
                            {
                                <div class="form-check">
                                    <InputRadio class="form-check-input" id="@($"frete-{o.Code}")" Value="o.Code" />
                                    <label class="form-check-label" for="@($"frete-{o.Code}")">
                                        @L[o.Name]: <strong>@(o.Amount == 0 ? L["Free"] : o.Amount.ToBrl())</strong>
                                        @if (o.DeliveryDays is int days) { <span class="text-secondary"> @L["(up to {0} business days)", days]</span> }
                                    </label>
                                </div>
                            }
                        </InputRadioGroup>
                    }
                </section>

                <section class="panel-box">
                    <h2 class="h4">@L["3. Payment"]</h2>
                    <InputRadioGroup @bind-Value="method">
                        <div class="form-check">
                            <InputRadio class="form-check-input" id="pg-pix" Value="PaymentMethod.Pix" />
                            <label class="form-check-label" for="pg-pix">
                                PIX @if (Store.Value.PixDiscountPercent > 0) { <span class="tag">@L["{0}% off", Store.Value.PixDiscountPercent.ToString("0.#")]</span> }
                            </label>
                        </div>
                        <div class="form-check">
                            <InputRadio class="form-check-input" id="pg-cartao" Value="PaymentMethod.CreditCard" />
                            <label class="form-check-label" for="pg-cartao">@L["Credit card (up to {0} interest-free installments)", Store.Value.InterestFreeInstallments]</label>
                        </div>
                    </InputRadioGroup>
                    <p class="small text-secondary mt-2 mb-0">@L["Card details never pass through our site: payment happens in the provider's secure environment."]</p>
                </section>
            </div>

            <div class="col-lg-5">
                <section class="panel-box position-sticky" style="top: 80px">
                    <h2 class="h4">@L["Order summary"]</h2>
                    @foreach (var item in Cart.Current.Items)
                    {
                        var p = products.GetValueOrDefault(item.ProductId);
                        <div class="d-flex justify-content-between small py-1">
                            <span>@item.Quantity× @(p?.Name ?? L["Product unavailable"])</span>
                            <span>@(((p?.Price ?? 0) * item.Quantity).ToBrl())</span>
                        </div>
                    }
                    <hr />
                    <div class="d-flex justify-content-between"><span>@L["Subtotal"]</span><span>@Subtotal.ToBrl()</span></div>
                    @if (Discount > 0)
                    {
                        <div class="d-flex justify-content-between text-success"><span>@L["PIX discount"]</span><span>− @Discount.ToBrl()</span></div>
                    }
                    <div class="d-flex justify-content-between"><span>@L["Shipping"]</span><span>@(SelectedShipping?.Amount.ToBrl() ?? "—")</span></div>
                    <div class="d-flex justify-content-between fs-5 mt-2"><strong>@L["Total"]</strong><strong>@Total.ToBrl()</strong></div>
                    @if (method == PaymentMethod.CreditCard && Store.Value.InterestFreeInstallments > 1)
                    {
                        <div class="text-end small text-secondary">@L["or {0} installments of {1}", Store.Value.InterestFreeInstallments, (Total / Store.Value.InterestFreeInstallments).ToBrl()]</div>
                    }

                    <p class="small text-secondary mt-3 mb-2">
                        @L["After confirming, you have {0} to pay. After that, the order is cancelled and the items go back to the store.", DeadlineText]
                    </p>

                    <div class="form-check mb-2">
                        <input class="form-check-input" type="checkbox" id="aceite" @bind="acceptedTerms" />
                        <label class="form-check-label small" for="aceite">
                            @L["I have read and accept"] <a href="terms-of-use" target="_blank">@L["the terms of use"]</a> @L["and"]
                            <a href="returns-policy" target="_blank">@L["the exchange policy"]</a>.
                        </label>
                    </div>

                    <Notice Message="@errorMessage" IsError="true" />

                    <button type="submit" class="btn btn-primary btn-lg w-100" disabled="@(processing || SelectedShipping is null || !acceptedTerms)">
                        @(processing ? L["Processing..."] : L["Confirm order"])
                    </button>
                    @if (SelectedShipping is null)
                    {
                        <p class="small text-secondary text-center mt-2 mb-0">@L["Calculate shipping to continue."]</p>
                    }
                </section>
            </div>
        </div>
    </EditForm>
}

@code {
    [CascadingParameter] private Task<AuthenticationState> AuthState { get; set; } = default!;

    private AddressForm address = new();
    private string? shippingCode;
    private PaymentMethod method = PaymentMethod.Pix;
    private Dictionary<int, Product> products = [];
    private IReadOnlyList<ShippingOption>? shippingOptions;
    private string? errorMessage;
    private bool processing, ready, acceptedTerms;
    private string customerId = "";

    private decimal Subtotal => Cart.Current.Items.Sum(i => (products.GetValueOrDefault(i.ProductId)?.Price ?? 0) * i.Quantity);
    private decimal Discount => method == PaymentMethod.Pix
        ? PixDiscountCalculator.Calculate(Subtotal, Store.Value.PixDiscountPercent) : 0;
    private ShippingOption? SelectedShipping => shippingOptions?.FirstOrDefault(o => o.Code == shippingCode);
    private decimal Total => Subtotal - Discount + (SelectedShipping?.Amount ?? 0);

    private string DeadlineText
    {
        get
        {
            var minutes = Store.Value.PaymentDeadlineMinutes;
            return minutes % 60 == 0 ? L["{0} hour(s)", minutes / 60] : L["{0} minutes", minutes];
        }
    }

    protected override async Task OnInitializedAsync()
    {
        customerId = (await AuthState).User.FindFirstValue(ClaimTypes.NameIdentifier) ?? "";

        // Sugere o endereço do último pedido
        var last = await Orders.GetLastAddressAsync(customerId);
        if (last is not null) address = AddressForm.FromAddress(last);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        await Cart.LoadAsync();
        products = await ProductService.GetByIdsAsync(Cart.Current.Items.Select(i => i.ProductId));
        ready = true;
        StateHasChanged();
    }

    private void ClearShipping()
    {
        shippingOptions = null;
        shippingCode = null;
    }

    private async Task CalculateShippingAsync()
    {
        errorMessage = null;
        if (PostalCode.Normalize(address.PostalCode) is not { } postalCode)
        {
            errorMessage = L["Enter a valid postal code to calculate shipping."];
            return;
        }
        processing = true;
        try
        {
            shippingOptions = await Orders.QuoteShippingAsync(postalCode, Cart.Current.Items);
            shippingCode = shippingOptions.FirstOrDefault(o => o.Amount > 0)?.Code ?? shippingOptions.FirstOrDefault()?.Code;
        }
        catch (OrderRuleException ex)
        {
            Logger.LogError(ex, "Falha ao cotar frete");
            errorMessage = L["Could not calculate shipping right now. Try again."];
        }
        finally
        {
            processing = false;
        }
    }

    private async Task FinishAsync()
    {
        if (processing || shippingCode is null || !acceptedTerms) return;
        processing = true;
        errorMessage = null;
        string? orderCode = null;
        try
        {
            var order = await Orders.CreateAsync(customerId, Cart.Current.Items, address.ToAddress(), shippingCode);
            orderCode = order.Code;
            await Orders.StartPaymentAsync(order.Id, method);
            await Cart.ClearAsync();
        }
        catch (OrderRuleException ex)
        {
            errorMessage = L.Translate(ex);
        }
        catch (InvalidOperationException ex)
        {
            Logger.LogError(ex, "Falha ao finalizar pedido");
            errorMessage = orderCode is null
                ? L["Could not complete the order. Try again."]
                : L["The order was created, but there was a problem starting the payment. Try paying from the order page."];
        }
        catch (TimeoutException ex)
        {
            Logger.LogError(ex, "Falha ao finalizar pedido");
            errorMessage = orderCode is null
                ? L["Could not complete the order. Try again."]
                : L["The order was created, but there was a problem starting the payment. Try paying from the order page."];
        }
        finally
        {
            processing = false;
        }

        if (orderCode is not null)
            Navigation.NavigateTo($"my-orders/{orderCode}?new=1");
    }
}
