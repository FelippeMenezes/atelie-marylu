@page "/checkout"
@rendermode InteractiveServer
@attribute [Authorize]
@using System.Security.Claims
@using AtelieMarylu.Domain.Carts
@using AtelieMarylu.Domain.Shipping
@using AtelieMarylu.Infrastructure.Integrations
@using AtelieMarylu.Web.Configuration
@using Microsoft.Extensions.Options
@inject ProductService ProductService
@inject CartService Cart
@inject OrderService Orders
@inject LastPostalCodeService LastPostalCode
@inject PostalCodeLookup PostalCodeLookup
@inject NavigationManager Navigation
@inject IOptions<ShopOptions> Store
@inject ILogger<Checkout> Logger

<PageTitle>@L["Checkout · Ateliê Marylu"]</PageTitle>

<h1>@L["Checkout"]</h1>

@if (!ready || createdOrderCode is not null)
{
    @* Também depois de criar o pedido: os itens já saíram do carrinho e a página vai para o pedido *@
    <div class="skeleton" style="height: 300px"></div>
}
else if (Cart.Current.IsEmpty)
{
    <p>@L["Your cart is empty."]</p>
    <a href="" class="btn btn-primary">@L["View products"]</a>
}
else
{
    <EditForm Model="address" OnValidSubmit="FinishAsync" FormName="checkout">
        <LocalizedDataAnnotationsValidator />
        <div class="row g-4">
            <div class="col-lg-7">
                <section class="panel-box mb-3">
                    <h2 class="h4">@L["1. Delivery address"]</h2>
                    <AddressFields Address="address" OnPostalCodeChanged="ClearShipping" />
                </section>

                <section class="panel-box mb-3">
                    <h2 class="h4">@L["2. Shipping"]</h2>
                    @* Prazo de preparo antes do prazo da transportadora: o prazo de entrega mostrado é "após o envio" *@
                    <p class="small text-secondary mb-2">
                        @if (ProductionDays is int days)
                        {
                            <strong>@L["Made to order:"]</strong> <text>@L["made within {0} business days after payment confirmation, plus shipping time.", days]</text>
                        }
                        else
                        {
                            <strong>@L["Ready to ship:"]</strong> <text>@L["we ship within 2 business days after payment confirmation."]</text>
                        }
                    </p>
                    @if (shippingOptions is null)
                    {
                        <button type="button" class="btn btn-outline-primary" @onclick="CalculateShippingAsync" disabled="@processing">@L["Calculate shipping"]</button>
                    }
                    else
                    {
                        <fieldset>
                            <legend class="small text-secondary">@L["Choose how you want to receive your order:"]</legend>
                            <InputRadioGroup @bind-Value="shippingCode">
                                @foreach (var o in shippingOptions)
                                {
                                    <div class="form-check">
                                        <InputRadio class="form-check-input" id="@($"frete-{o.Code}")" Value="o.Code" />
                                        <label class="form-check-label" for="@($"frete-{o.Code}")">
                                            @L[o.Name]: <strong>@(o.Amount == 0 ? L["Free"] : o.Amount.ToBrl())</strong>
                                            @if (o.DeliveryDays is int days) { @(" ")<span class="text-secondary">@L["(up to {0} business days after shipping)", days]</span> }
                                        </label>
                                    </div>
                                }
                            </InputRadioGroup>
                        </fieldset>
                    }
                </section>

                <section class="panel-box">
                    <h2 class="h4">@L["3. Payment"]</h2>
                    <InputRadioGroup @bind-Value="method">
                        <div class="form-check">
                            <InputRadio class="form-check-input" id="pg-pix" Value="PaymentMethod.Pix" />
                            <label class="form-check-label" for="pg-pix">
                                PIX @if (Store.Value.PixDiscountPercent > 0) { <span class="tag">@L["{0}% off", Store.Value.PixDiscountPercent.ToString("0.#")]</span> }
                            </label>
                        </div>
                        <div class="form-check">
                            <InputRadio class="form-check-input" id="pg-cartao" Value="PaymentMethod.CreditCard" />
                            <label class="form-check-label" for="pg-cartao">@L["Credit card (up to {0} interest-free installments)", Store.Value.InterestFreeInstallments]</label>
                        </div>
                    </InputRadioGroup>
                    <p class="small text-secondary mt-2 mb-0">@L["Card details never pass through our site: payment happens in the provider's secure environment."]</p>
                </section>
            </div>

            <div class="col-lg-5">
                <section class="panel-box position-sticky" style="top: 80px">
                    <h2 class="h4">@L["Order summary"]</h2>
                    @foreach (var item in Cart.Current.Items)
                    {
                        var p = products.GetValueOrDefault(item.ProductId);
                        <div class="d-flex justify-content-between small py-1">
                            <span>@item.Quantity× @(p?.Name ?? L["Product unavailable"])</span>
                            <span>@(((p?.Price ?? 0) * item.Quantity).ToBrl())</span>
                        </div>
                    }
                    <hr />
                    <div class="d-flex justify-content-between"><span>@L["Subtotal"]</span><span>@Subtotal.ToBrl()</span></div>
                    @if (Discount > 0)
                    {
                        <div class="d-flex justify-content-between text-success"><span>@L["PIX discount"]</span><span>− @Discount.ToBrl()</span></div>
                    }
                    <div class="d-flex justify-content-between"><span>@L["Shipping"]</span><span>@(SelectedShipping?.Amount.ToBrl() ?? "—")</span></div>
                    <div class="d-flex justify-content-between fs-5 mt-2"><strong>@L["Total"]</strong><strong>@Total.ToBrl()</strong></div>
                    @if (method == PaymentMethod.CreditCard && Store.Value.InterestFreeInstallments > 1)
                    {
                        <div class="text-end small text-secondary">@L["or {0} installments of {1}", Store.Value.InterestFreeInstallments, (Total / Store.Value.InterestFreeInstallments).ToBrl()]</div>
                    }

                    <p class="small text-secondary mt-3 mb-2">
                        @L["After confirming, you have {0} to pay. After that, the order is cancelled and the items go back to the store.", DeadlineText]
                    </p>

                    <div class="form-check mb-2">
                        <input class="form-check-input" type="checkbox" id="aceite" @bind="acceptedTerms" />
                        <label class="form-check-label small" for="aceite">
                            @L["I have read and accept"] <a href="terms-of-use" target="_blank">@L["the terms of use"]</a> @L["and"]
                            <a href="returns-policy" target="_blank">@L["the exchange policy"]</a>.
                        </label>
                    </div>

                    <Notice Message="@errorMessage" IsError="true" />

                    <button type="submit" class="btn btn-primary btn-lg w-100" disabled="@(processing || SelectedShipping is null || !acceptedTerms)">
                        @(processing ? L["Processing..."] : L["Confirm order"])
                    </button>
                    @if (shippingOptions is null)
                    {
                        <p class="small text-secondary text-center mt-2 mb-0">@L["Calculate shipping to continue."]</p>
                    }
                    else if (SelectedShipping is null)
                    {
                        <p class="small text-secondary text-center mt-2 mb-0">@L["Choose a delivery method to continue."]</p>
                    }
                </section>
            </div>
        </div>
    </EditForm>
}

@code {
    [CascadingParameter] private Task<AuthenticationState> AuthState { get; set; } = default!;

    private AddressForm address = new();
    private string? shippingCode;
    private PaymentMethod method = PaymentMethod.Pix;
    private Dictionary<int, Product> products = [];
    private IReadOnlyList<ShippingOption>? shippingOptions;
    private string? errorMessage;
    private bool processing, ready, acceptedTerms;
    private string customerId = "";
    private string? createdOrderCode;

    private decimal Subtotal => Cart.Current.Items.Sum(i => (products.GetValueOrDefault(i.ProductId)?.Price ?? 0) * i.Quantity);
    private decimal Discount => method == PaymentMethod.Pix
        ? PixDiscountCalculator.Calculate(Subtotal, Store.Value.PixDiscountPercent) : 0;
    private ShippingOption? SelectedShipping => shippingOptions?.FirstOrDefault(o => o.Code == shippingCode);
    private decimal Total => Subtotal - Discount + (SelectedShipping?.Amount ?? 0);

    // O pedido sai inteiro: com peças sob encomenda, vale o maior prazo de produção do carrinho
    private int? ProductionDays => Cart.Current.Items.Max(i => products.GetValueOrDefault(i.ProductId)?.ProductionDays);

    private string DeadlineText
    {
        get
        {
            var minutes = Store.Value.PaymentDeadlineMinutes;
            return minutes % 60 == 0 ? L["{0} hour(s)", minutes / 60] : L["{0} minutes", minutes];
        }
    }

    protected override async Task OnInitializedAsync()
    {
        customerId = (await AuthState).User.FindFirstValue(ClaimTypes.NameIdentifier) ?? "";
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        await Cart.LoadAsync();
        products = await ProductService.GetByIdsAsync(Cart.Current.Items.Select(i => i.ProductId));
        await SuggestAddressAsync();
        ready = true;
        StateHasChanged();
    }

    // O endereço começa pelo último CEP com que a cliente calculou o frete (no produto, no carrinho ou aqui).
    // Sem cotação recente, o formulário começa vazio. Antes, ele trazia sempre o endereço do último pedido,
    // e a cliente via um CEP "fixo" que nem era o que ela tinha acabado de cotar.
    // Fica no OnAfterRenderAsync porque o CEP mora no navegador (precisa de JS interop).
    private async Task SuggestAddressAsync()
    {
        if (await LastPostalCode.GetAsync() is not { } postalCode) return;

        // Se for o CEP do último pedido, reaproveita o endereço inteiro (com número e complemento)
        var last = await Orders.GetLastAddressAsync(customerId);
        if (last is not null && PostalCode.Normalize(last.PostalCode) == postalCode)
        {
            address = AddressForm.FromAddress(last);
            return;
        }

        // CEP novo: rua, bairro e cidade pelo ViaCEP; o número fica com a cliente
        address = AddressForm.WithPostalCode(postalCode);
        if (await PostalCodeLookup.FindAsync(postalCode) is { } found)
            address.Fill(found);
    }

    private void ClearShipping()
    {
        shippingOptions = null;
        shippingCode = null;
    }

    private async Task CalculateShippingAsync()
    {
        errorMessage = null;
        if (PostalCode.Normalize(address.PostalCode) is not { } postalCode)
        {
            errorMessage = L["Enter a valid postal code to calculate shipping."];
            return;
        }
        processing = true;
        try
        {
            shippingOptions = await Orders.QuoteShippingAsync(postalCode, Cart.Current.Items);
            await LastPostalCode.SaveAsync(postalCode);
            // Nada vem marcado: a forma de entrega é escolha da cliente (AML-0039), e o botão de confirmar
            // só libera depois dela. Uma opção pré-marcada passa despercebida e vira reclamação depois.
            shippingCode = null;
        }
        catch (OrderRuleException ex)
        {
            // O OrderService já registrou a falha do provedor no log; aqui só a mensagem
            errorMessage = L.Translate(ex);
        }
        finally
        {
            processing = false;
        }
    }

    private async Task FinishAsync()
    {
        if (processing || createdOrderCode is not null || shippingCode is null || !acceptedTerms) return;
        processing = true;
        errorMessage = null;
        try
        {
            // Cópia dos itens: o pedido nasce do que a cliente estava vendo, não de uma lista que pode mudar no meio
            var items = Cart.Current.Items.ToList();
            var order = await Orders.CreateAsync(customerId, items, address.ToAddress(), shippingCode,
                shownShippingAmount: SelectedShipping?.Amount);
            createdOrderCode = order.Code;

            // Daqui em diante quem guarda os itens (e o estoque reservado) é o pedido. Tirar do carrinho
            // antes de abrir o pagamento evita que uma falha no PagBank deixe o carrinho cheio e a cliente
            // finalize de novo, criando um segundo pedido e segurando o estoque em dobro (AML-0037).
            // Sai só o que entrou no pedido: o que foi acrescentado em outra aba continua no carrinho.
            await TryRemoveOrderedFromCartAsync(items);

            await Orders.StartPaymentAsync(order.Id, method);
        }
        catch (ShippingPriceChangedException ex)
        {
            // O pedido não foi criado. Recalcula para a lista mostrar o valor novo; nada fica marcado,
            // então a cliente escolhe e confirma de novo, sabendo quanto vai pagar
            var message = L.Translate(ex);
            processing = false;
            await CalculateShippingAsync();
            errorMessage = message;
        }
        catch (OrderRuleException ex)
        {
            errorMessage = L.Translate(ex);
        }
        catch (InvalidOperationException ex)
        {
            Logger.LogError(ex, "Falha ao finalizar pedido");
            errorMessage = FailureMessage();
        }
        catch (PaymentGatewayException ex)
        {
            // Só acontece depois de o pedido existir: o cliente tenta pagar de novo pela página do pedido
            Logger.LogError(ex, "Falha ao iniciar o pagamento do pedido");
            errorMessage = FailureMessage();
        }
        catch (TimeoutException ex)
        {
            Logger.LogError(ex, "Falha ao finalizar pedido");
            errorMessage = FailureMessage();
        }
        finally
        {
            processing = false;
        }

        // Com o pedido criado, a página dele é o lugar certo para qualquer falha de pagamento:
        // ela mostra "O pagamento não abriu" com "Tentar de novo" (AML-0035).
        if (createdOrderCode is not null)
            Navigation.NavigateTo($"my-orders/{createdOrderCode}?new=1");
    }

    private string FailureMessage() => createdOrderCode is null
        ? L["Could not complete the order. Try again."]
        : L["The order was created, but there was a problem starting the payment. Try paying from the order page."];

    // Melhor esforço: o pedido já está gravado, então uma falha ao falar com o navegador não pode
    // impedir o pagamento nem virar uma mensagem de erro que leve a cliente a finalizar de novo.
    // No pior caso, os itens continuam no carrinho (o comportamento antigo). Só as falhas de JS interop são
    // capturadas; qualquer outra coisa é bug e deve subir.
    private async Task TryRemoveOrderedFromCartAsync(IReadOnlyList<CartItem> ordered)
    {
        try
        {
            await Cart.RemoveOrderedAsync(ordered);
        }
        catch (Exception ex) when (ex is JSDisconnectedException or JSException or TaskCanceledException)
        {
            Logger.LogWarning(ex, "Pedido {OrderCode} criado, mas os itens não puderam ser tirados do carrinho", createdOrderCode);
        }
    }
}
