@page "/meus-pedidos"
@attribute [Authorize]
@using System.Security.Claims
@inject OrderService Orders

<PageTitle>@L["Meus pedidos · Ateliê Marylu"]</PageTitle>

<h1>@L["Meus pedidos"]</h1>

@if (orders.Count == 0)
{
    <p>@L["Você ainda não fez nenhum pedido."]</p>
    <a href="" class="btn btn-primary">@L["Ver produtos"]</a>
}
else
{
    <OrdersTable Orders="orders" Link="meus-pedidos" ByCode="true" />
}

@code {
    [CascadingParameter] private Task<AuthenticationState> AuthState { get; set; } = default!;

    private List<Order> orders = [];

    protected override async Task OnInitializedAsync()
    {
        var customerId = (await AuthState).User.FindFirstValue(ClaimTypes.NameIdentifier);
        orders = await Orders.ListForCustomerAsync(customerId);
    }
}
