@page "/my-orders"
@attribute [Authorize]
@using System.Security.Claims
@inject OrderService Orders

<PageTitle>@L["My orders · Ateliê Marylu"]</PageTitle>

<h1>@L["My orders"]</h1>

@if (orders.Count == 0)
{
    <p>@L["You haven't placed any orders yet."]</p>
    <a href="" class="btn btn-primary">@L["View products"]</a>
}
else
{
    <OrdersTable Orders="orders" Link="my-orders" ByCode="true" />
}

@code {
    [CascadingParameter] private Task<AuthenticationState> AuthState { get; set; } = default!;

    private List<Order> orders = [];

    protected override async Task OnInitializedAsync()
    {
        var customerId = (await AuthState).User.FindFirstValue(ClaimTypes.NameIdentifier);
        orders = await Orders.ListForCustomerAsync(customerId);
    }
}
