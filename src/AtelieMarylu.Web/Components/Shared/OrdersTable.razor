@using AtelieMarylu.Web.Configuration
@* A linha inteira abre o pedido (.row-link, regra em app.css) *@
<div class="table-responsive panel-box p-0">
    <table class="table table-fluid align-middle m-0">
        <thead>
            <tr>
                <th>@L["Order"]</th>
                <th>@L["Date"]</th>
                @if (CustomerNames is not null)
                {
                    <th>@L["Customer"]</th>
                }
                <th>@L["Status"]</th>
                <th class="text-end">@L["Total"]</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var p in Orders)
            {
                var href = $"{Link}/{(ByCode ? p.Code : p.Id.ToString())}";
                <tr class="row-link">
                    <td class="text-nowrap"><a href="@href" class="row-link-main">@p.Code</a></td>
                    <td>@p.CreatedAt.FormatBrasilia()<CellLink Href="@href" /></td>
                    @if (CustomerNames is not null)
                    {
                        <td>@CustomerNames.GetValueOrDefault(p.CustomerId)<CellLink Href="@href" /></td>
                    }
                    <td><OrderStatusBadge Status="p.Status" /><CellLink Href="@href" /></td>
                    <td class="text-end text-nowrap">@p.Total.ToBrl()<CellLink Href="@href" /></td>
                </tr>
            }
        </tbody>
    </table>
</div>

@code {
    // Os pedidos precisam vir com Itens carregados (o Total depende deles)
    [Parameter, EditorRequired] public IReadOnlyList<Order> Orders { get; set; } = [];
    [Parameter, EditorRequired] public string Link { get; set; } = "";
    [Parameter] public IReadOnlyDictionary<string, string>? CustomerNames { get; set; }

    // Cliente usa o código público na URL; o painel usa o Id interno
    [Parameter] public bool ByCode { get; set; }
}
