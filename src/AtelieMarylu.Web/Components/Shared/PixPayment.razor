@using AtelieMarylu.Infrastructure.Integrations
@implements IAsyncDisposable
@inject IJSRuntime JS

<div class="d-flex gap-4 flex-wrap align-items-start">
    <img class="pix-qr" src="@qrCode" alt="QR code do PIX" />
    <div class="flex-grow-1" style="min-width: 220px">
        <p class="mb-1">Abra o app do seu banco, escolha <strong>PIX → Ler QR code</strong> ou use o código copia e cola:</p>
        <p class="pix small">@Code</p>
        <button type="button" class="btn btn-primary btn-sm" @onclick="Copy">@(copied ? "Código copiado!" : "Copiar código PIX")</button>
        <p class="small text-secondary mt-2 mb-0">Valor: <strong>@Amount.ToString("C")</strong>. A confirmação aparece aqui automaticamente.</p>
    </div>
</div>

@code {
    [Parameter, EditorRequired] public string Code { get; set; } = "";
    [Parameter, EditorRequired] public decimal Amount { get; set; }

    private string qrCode = "";
    private bool copied;
    private IJSObjectReference? jsModule;

    protected override void OnParametersSet() => qrCode = PixQrCodeGenerator.GenerateDataUri(Code);

    private async Task Copy()
    {
        jsModule ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/store.js");
        copied = await jsModule.InvokeAsync<bool>("copyText", Code);
    }

    public async ValueTask DisposeAsync()
    {
        if (jsModule is null) return;
        try
        {
            await jsModule.DisposeAsync();
        }
        catch (JSDisconnectedException)
        {
            // O navegador já fechou a conexão; não há o que liberar do lado dele
            jsModule = null;
        }
    }
}
