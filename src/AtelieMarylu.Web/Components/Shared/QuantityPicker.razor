@* Seletor − / + (mais fácil de tocar no celular do que um campo numérico) *@
<span class="quantity" role="group" aria-label="@L["Quantidade"]">
    <button type="button" @onclick="() => ChangeValue(Value - 1)" disabled="@(Disabled || Value <= Min)" aria-label="@L["Diminuir"]">−</button>
    <span aria-live="polite">@Value</span>
    <button type="button" @onclick="() => ChangeValue(Value + 1)" disabled="@(Disabled || Value >= Max)" aria-label="@L["Aumentar"]">+</button>
</span>

@code {
    [Parameter] public int Value { get; set; } = 1;
    [Parameter] public int Min { get; set; } = 1;
    [Parameter] public int Max { get; set; } = AtelieMarylu.Domain.Carts.Cart.MaxQuantityPerItem;
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public EventCallback<int> ValueChanged { get; set; }

    private Task ChangeValue(int isNew) => ValueChanged.InvokeAsync(Math.Clamp(isNew, Min, Max));
}
