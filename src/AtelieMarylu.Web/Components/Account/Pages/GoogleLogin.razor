@page "/Account/LoginGoogle"

@using System.ComponentModel.DataAnnotations
@using System.Security.Claims
@using Microsoft.AspNetCore.Authentication
@using Microsoft.AspNetCore.Identity
@using AtelieMarylu.Infrastructure.Data
@using AtelieMarylu.Web.Validation
@using AtelieMarylu.Domain.Security

@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager
@inject IUserStore<ApplicationUser> UserStore
@inject IdentityRedirectManager RedirectManager
@inject ILogger<GoogleLogin> Logger

@* Volta do Google. Quem já tem a conta Google conectada entra direto; quem é novo confirma
   o nome e a conta é criada com o e-mail que o Google informou. *@

<PageTitle>@L["Create account · Ateliê Marylu"]</PageTitle>

<h1>@L["Almost there!"]</h1>
<StatusMessage Message="@message" />

@if (googleInfo is not null && email is not null)
{
    <div class="row">
        <div class="col-lg-6">
            <p>@L["You signed in with"] <strong>Google</strong> @L["as"] <strong>@email</strong>@L[". Check your details to create your store account."]</p>
            <EditForm Model="Input" OnValidSubmit="CreateAccountAsync" FormName="confirmation" method="post">
                <LocalizedDataAnnotationsValidator />
                <ValidationSummary class="text-danger" role="alert" />
                <div class="form-floating mb-3">
                    <InputText @bind-Value="Input.FullName" id="Input.FullName" class="form-control" autocomplete="name" aria-required="true" placeholder="@L["Your name"]" />
                    <label for="Input.FullName">@L["Full name"]</label>
                    <ValidationMessage For="() => Input.FullName" class="text-danger" />
                </div>
                <div class="form-floating mb-3">
                    <InputText @bind-Value="Input.Phone" id="Input.Phone" class="form-control" autocomplete="tel" placeholder="(21) 99999-9999" />
                    <label for="Input.Phone">@L["Phone / WhatsApp (optional)"]</label>
                    <ValidationMessage For="() => Input.Phone" class="text-danger" />
                </div>
                <p class="small text-secondary">@L["By creating an account you agree to"] <a href="terms-of-use" target="_blank">@L["the terms of use"]</a> @L["and"] <a href="privacy-policy" target="_blank">@L["the privacy policy"]</a>.</p>
                <button type="submit" class="w-100 btn btn-lg btn-primary">@L["Create account"]</button>
            </EditForm>
        </div>
    </div>
}
else
{
    <p><a href="Account/Login">@L["Back to sign in"]</a></p>
}

@code {
    public const string LoginCallbackAction = "LoginCallback";

    private ExternalLoginInfo? googleInfo;
    private string? email;
    private string? message;

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    [SupplyParameterFromForm]
    private InputModel Input { get; set; } = default!;

    [SupplyParameterFromQuery]
    private string? RemoteError { get; set; }

    [SupplyParameterFromQuery]
    private string? ReturnUrl { get; set; }

    [SupplyParameterFromQuery]
    private string? Action { get; set; }

    protected override async Task OnInitializedAsync()
    {
        Input ??= new();

        if (RemoteError is not null)
        {
            // Ex.: a pessoa clicou em "Cancelar" na tela do Google
            Logger.LogInformation("Login com Google cancelado ou recusado: {Erro}", RemoteError);
            RedirectManager.RedirectToWithStatus("Account/Login", L["Error: the Google sign-in was not completed. Try again."], HttpContext);
            return;
        }

        var info = await SignInManager.GetExternalLoginInfoAsync();
        if (info is null)
        {
            RedirectManager.RedirectToWithStatus("Account/Login", L["Error: could not load the Google data. Try again."], HttpContext);
            return;
        }

        if (!IsEmailConfirmedByGoogle(info, out var googleEmail))
        {
            await HttpContext.SignOutAsync(IdentityConstants.ExternalScheme);
            RedirectManager.RedirectToWithStatus("Account/Login",
                L["Error: the Google account did not provide a confirmed email. Use another account or sign up with email and password."], HttpContext);
            return;
        }

        googleInfo = info;
        email = googleEmail;

        if (HttpMethods.IsGet(HttpContext.Request.Method))
        {
            if (Action == LoginCallbackAction)
            {
                await OnReturnFromGoogleAsync();
                return;
            }

            // Ninguém deveria abrir esta página direto
            RedirectManager.RedirectTo("Account/Login");
        }
    }

    private async Task OnReturnFromGoogleAsync()
    {
        var info = googleInfo!;

        var result = await SignInManager.ExternalLoginSignInAsync(info.LoginProvider, info.ProviderKey, isPersistent: false, bypassTwoFactor: false);
        if (result.Succeeded)
        {
            Logger.LogInformation("Login com Google.");
            RedirectManager.RedirectTo(ReturnUrl);
            return;
        }
        if (result.IsLockedOut)
        {
            RedirectManager.RedirectTo("Account/Lockout");
            return;
        }

        // Não conecta sozinho a uma conta que já existe com o mesmo e-mail: a pessoa entra com a senha
        // e conecta pelo "Minha conta". Assim, só quem sabe a senha decide quem mais pode entrar na conta.
        if (await UserManager.FindByEmailAsync(email!) is not null)
        {
            await HttpContext.SignOutAsync(IdentityConstants.ExternalScheme);
            RedirectManager.RedirectToWithStatus("Account/Login",
                L["Error: an account with the email {0} already exists. Sign in with your password and connect Google in My account → Google account.", email!], HttpContext);
            return;
        }

        // Pessoa nova: mostra o formulário já com o nome que veio do Google
        Input.FullName = info.Principal.FindFirstValue(ClaimTypes.Name) ?? "";
    }

    private async Task CreateAccountAsync()
    {
        var info = googleInfo!;

        var user = new ApplicationUser
        {
            FullName = Input.FullName.Trim(),
            PhoneNumber = string.IsNullOrWhiteSpace(Input.Phone) ? null : Input.Phone.Trim(),
            // O Google já confirmou que o e-mail é da pessoa (veja IsEmailConfirmedByGoogle)
            EmailConfirmed = true,
        };
        await UserStore.SetUserNameAsync(user, email, CancellationToken.None);
        await ((IUserEmailStore<ApplicationUser>)UserStore).SetEmailAsync(user, email, CancellationToken.None);

        var result = await UserManager.CreateAsync(user);
        if (result.Succeeded)
        {
            result = await UserManager.AddLoginAsync(user, info);
            if (!result.Succeeded)
                await UserManager.DeleteAsync(user);   // não deixa uma conta sem forma de entrar
        }
        if (!result.Succeeded)
        {
            message = $"Erro: {string.Join(" ", result.Errors.Select(e => e.Description))}";
            return;
        }

        await UserManager.AddToRoleAsync(user, AppRoles.Customer);
        Logger.LogInformation("Conta criada com Google.");

        await SignInManager.SignInAsync(user, isPersistent: false, info.LoginProvider);
        await HttpContext.SignOutAsync(IdentityConstants.ExternalScheme);
        RedirectManager.RedirectTo(ReturnUrl);
    }

    // O Google informa se confirmou o e-mail (email_verified); e-mail não confirmado é recusado
    private static bool IsEmailConfirmedByGoogle(ExternalLoginInfo info, out string? email)
    {
        email = info.Principal.FindFirstValue(ClaimTypes.Email);
        if (string.IsNullOrWhiteSpace(email) || !new EmailAddressAttribute().IsValid(email))
            return false;
        return info.Principal.FindFirstValue("email_verified") is not "false" and not "False";
    }

    private sealed class InputModel
    {
        [Required(ErrorMessage = "Enter the name.")]
        [StringLength(150)]
        [Display(Name = "Full name")]
        public string FullName { get; set; } = "";

        [OptionalPhone(ErrorMessage = "Invalid phone number.")]
        [StringLength(20)]
        [Display(Name = "Phone")]
        public string? Phone { get; set; }
    }
}
