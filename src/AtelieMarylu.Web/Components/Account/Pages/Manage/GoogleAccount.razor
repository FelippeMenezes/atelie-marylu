@page "/Account/Manage/Google"

@using Microsoft.AspNetCore.Authentication
@using Microsoft.AspNetCore.Authentication.Google
@using Microsoft.AspNetCore.Identity
@using Microsoft.Extensions.Options
@using AtelieMarylu.Web.Configuration
@using AtelieMarylu.Infrastructure.Data

@inject UserManager<ApplicationUser> UserManager
@inject SignInManager<ApplicationUser> SignInManager
@inject IdentityRedirectManager RedirectManager
@inject IOptions<GoogleLoginOptions> GoogleOptions

<PageTitle>@L["Google account · Ateliê Marylu"]</PageTitle>

<StatusMessage />
<h3>@L["Google account"]</h3>

@if (!GoogleOptions.Value.IsActive)
{
    <p>@L["Google sign-in is not available right now."]</p>
}
else if (googleLogin is not null)
{
    <p>@L["Your Google account is connected. You can sign in to the store with the button"] <strong>@L["Continue with Google"]</strong>.</p>
    @if (hasPassword)
    {
        <form @formname="desconectar-google" @onsubmit="DisconnectAsync" method="post">
            <AntiforgeryToken />
            <button type="submit" class="btn btn-outline-danger">@L["Disconnect Google account"]</button>
        </form>
    }
    else
    {
        <p class="small text-secondary">@L["Google is the only way to sign in to your account. To disconnect it, first create"] <a href="Account/Manage/SetPassword">@L["a password"]</a>.</p>
    }
}
else
{
    <p>@L["Connect your Google account to sign in with one click, without typing a password."]</p>
    <div style="max-width: 320px">
        <GoogleButton Action="@GoogleButton.ConnectAction" Text="@L["Connect Google account"]" />
    </div>
}

@code {
    public const string ConnectCallbackAction = "ConectarCallback";

    private ApplicationUser user = default!;
    private UserLoginInfo? googleLogin;
    private bool hasPassword;

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    [SupplyParameterFromQuery]
    private string? Action { get; set; }

    protected override async Task OnInitializedAsync()
    {
        var loadedUser = await UserManager.GetUserAsync(HttpContext.User);
        if (loadedUser is null)
        {
            RedirectManager.RedirectToInvalidUser(UserManager, HttpContext);
            return;
        }
        user = loadedUser;

        googleLogin = (await UserManager.GetLoginsAsync(user)).FirstOrDefault(l => l.LoginProvider == GoogleDefaults.AuthenticationScheme);
        hasPassword = await UserManager.HasPasswordAsync(user);

        if (HttpMethods.IsGet(HttpContext.Request.Method) && Action == ConnectCallbackAction)
            await OnReturnFromGoogleAsync();
    }

    private async Task DisconnectAsync()
    {
        // Sem senha, desconectar o Google deixaria a pessoa trancada fora da conta
        if (googleLogin is null || !hasPassword)
        {
            RedirectManager.RedirectToCurrentPageWithStatus(L["Error: create a password before disconnecting Google."], HttpContext);
            return;
        }

        var result = await UserManager.RemoveLoginAsync(user, googleLogin.LoginProvider, googleLogin.ProviderKey);
        if (!result.Succeeded)
        {
            RedirectManager.RedirectToCurrentPageWithStatus(L["Error: could not disconnect the Google account."], HttpContext);
            return;
        }

        await SignInManager.RefreshSignInAsync(user);
        RedirectManager.RedirectToCurrentPageWithStatus(L["Google account disconnected."], HttpContext);
    }

    private async Task OnReturnFromGoogleAsync()
    {
        // O userId confere que quem voltou do Google é a mesma pessoa que clicou em "Conectar"
        var info = await SignInManager.GetExternalLoginInfoAsync(await UserManager.GetUserIdAsync(user));
        if (info is null)
        {
            RedirectManager.RedirectToCurrentPageWithStatus(L["Error: could not load the Google data. Try again."], HttpContext);
            return;
        }

        var result = await UserManager.AddLoginAsync(user, info);
        await HttpContext.SignOutAsync(IdentityConstants.ExternalScheme);
        if (!result.Succeeded)
        {
            RedirectManager.RedirectToCurrentPageWithStatus(L["Error: that Google account is already connected to another store account."], HttpContext);
            return;
        }

        RedirectManager.RedirectToCurrentPageWithStatus(L["Google account connected."], HttpContext);
    }
}
