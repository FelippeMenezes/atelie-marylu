@page "/Account/Manage/PersonalData"

@using Microsoft.AspNetCore.Identity
@using AtelieMarylu.Infrastructure.Data

@inject UserManager<ApplicationUser> UserManager
@inject IdentityRedirectManager RedirectManager

<PageTitle>@L["Dados pessoais"]</PageTitle>

<StatusMessage />
<h3>@L["Dados pessoais"]</h3>

<div class="row">
    <div class="col-md-6">
        <p>@L["Sua conta guarda os dados pessoais que você nos informou. Aqui você pode baixar ou excluir esses dados."]</p>
        <p>
            <strong>@L["Excluir estes dados remove a sua conta para sempre. Não é possível desfazer."]</strong>
        </p>
        <form action="Account/Manage/DownloadPersonalData" method="post">
            <AntiforgeryToken />
            <button class="btn btn-primary" type="submit">@L["Baixar meus dados"]</button>
        </form>
        <p>
            <a href="Account/Manage/DeletePersonalData" class="btn btn-danger">@L["Excluir conta"]</a>
        </p>
    </div>
</div>

@code {
    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    protected override async Task OnInitializedAsync()
    {
        var user  = await UserManager.GetUserAsync(HttpContext.User);
        if (user is null)
        {
            RedirectManager.RedirectToInvalidUser(UserManager, HttpContext);
        }
    }
}
