@page "/Account/ConfirmEmail"

@using Microsoft.AspNetCore.Identity
@using AtelieMarylu.Infrastructure.Data

@inject UserManager<ApplicationUser> UserManager
@inject IdentityRedirectManager RedirectManager
@inject ILogger<ConfirmEmail> Logger

<PageTitle>@L["Confirm email · Ateliê Marylu"]</PageTitle>

<h1>@L["Confirm email"]</h1>
<StatusMessage Message="@statusMessage" />
@if (confirmed)
{
    <p><a class="btn btn-primary" href="">@L["Back to the store"]</a></p>
}
else
{
    <p><a href="Account/ResendEmailConfirmation">@L["Send the confirmation email again"]</a></p>
}

@code {
    private string? statusMessage;
    private bool confirmed;

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    [SupplyParameterFromQuery]
    private string? UserId { get; set; }

    [SupplyParameterFromQuery]
    private string? Code { get; set; }

    protected override async Task OnInitializedAsync()
    {
        if (UserId is null || Code is null)
        {
            RedirectManager.RedirectTo("");
            return;
        }

        // Usuário inexistente e código inválido dão a mesma mensagem: o link simplesmente não serve
        var user = await UserManager.FindByIdAsync(UserId);
        var token = AccountEmailLinks.DecodeToken(Code);
        var result = user is null || token is null ? null : await UserManager.ConfirmEmailAsync(user, token);

        confirmed = result?.Succeeded == true;
        if (confirmed)
        {
            var safeUserId = UserId.Replace("\r", string.Empty).Replace("\n", string.Empty);
            Logger.LogInformation("User {UserId} confirmed their email.", safeUserId);
            statusMessage = L["Thank you! Your email is confirmed."];
        }
        else
        {
            HttpContext.Response.StatusCode = StatusCodes.Status400BadRequest;
            statusMessage = L["Error: this confirmation link is invalid or has expired."];
        }
    }
}
