@page "/Account/ForgotPassword"

@using System.ComponentModel.DataAnnotations
@using Microsoft.AspNetCore.Identity
@using AtelieMarylu.Infrastructure.Data

@inject UserManager<ApplicationUser> UserManager
@inject IEmailSender<ApplicationUser> EmailSender
@inject AccountEmailLinks Links
@inject IdentityRedirectManager RedirectManager
@inject ILogger<ForgotPassword> Logger

<PageTitle>@L["Forgot password · Ateliê Marylu"]</PageTitle>

<h1>@L["Forgot your password?"]</h1>
<div class="row">
    <div class="col-lg-6">
        <p>@L["Enter the email of your account. We will send you a link to create a new password."]</p>
        <hr />
        <EditForm Model="Input" FormName="forgot-password" OnValidSubmit="OnValidSubmitAsync" method="post">
            <LocalizedDataAnnotationsValidator />
            <ValidationSummary class="text-danger" role="alert" />
            <div class="form-floating mb-3">
                <InputText @bind-Value="Input.Email" id="Input.Email" class="form-control" autocomplete="username" aria-required="true" placeholder="name@example.com" />
                <label for="Input.Email" class="form-label">@L["Email"]</label>
                <ValidationMessage For="() => Input.Email" class="text-danger" />
            </div>
            <button type="submit" class="w-100 btn btn-lg btn-primary">@L["Send link"]</button>
        </EditForm>
        <p class="mt-3"><a href="Account/Login">@L["Back to sign in"]</a></p>
    </div>
</div>

@code {
    [SupplyParameterFromForm]
    private InputModel Input { get; set; } = default!;

    protected override void OnInitialized()
    {
        Input ??= new();
    }

    private async Task OnValidSubmitAsync()
    {
        var user = await UserManager.FindByEmailAsync(Input.Email);

        // Regra (opção B, a mais comum no mercado): o link vai para qualquer conta com este e-mail,
        // confirmada ou não. Quem abre o link prova que tem acesso à caixa de entrada, e isso vale
        // como confirmação do e-mail (o AccountRecoveryService marca EmailConfirmed ao trocar a senha).
        // - Por que não exigir o e-mail confirmado (regra do modelo do .NET): a confirmação só passou a
        //   existir no AML-0025, então quase nenhum cliente antigo conseguiria recuperar a conta.
        // - E se alguém se cadastrou com o e-mail de outra pessoa? O link vai para a dona do e-mail,
        //   que é quem tem direito à conta. Quem usou o e-mail alheio não recebe nada.
        if (user is not null)
        {
            try
            {
                await EmailSender.SendPasswordResetLinkAsync(user, Input.Email, await Links.PasswordResetAsync(user));
                Logger.LogInformation("Password reset link sent to user {UserId}.", user.Id);
            }
            catch (EmailDeliveryException ex)
            {
                // Se o envio falhar, a tela responde igual: um erro só para e-mails existentes revelaria quem é cliente
                Logger.LogError(ex, "Could not send the password reset email to user {UserId}.", user.Id);
            }
        }

        // A resposta é sempre a mesma, exista o e-mail ou não
        RedirectManager.RedirectTo("Account/ForgotPasswordConfirmation");
    }

    private sealed class InputModel
    {
        [Required(ErrorMessage = "Enter your email.")]
        [EmailAddress(ErrorMessage = "Invalid email.")]
        public string Email { get; set; } = "";
    }
}
