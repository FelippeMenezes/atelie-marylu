@page "/Account/Register"

@using System.ComponentModel.DataAnnotations
@using Microsoft.AspNetCore.Identity
@using AtelieMarylu.Infrastructure.Data
@using AtelieMarylu.Domain.Text
@using AtelieMarylu.Web.Validation
@using AtelieMarylu.Web.Services

@inject SignInManager<ApplicationUser> SignInManager
@inject NavigationManager NavigationManager
@inject IdentityRedirectManager RedirectManager
@inject AtelieMarylu.Infrastructure.Integrations.Turnstile Turnstile
@inject AtelieMarylu.Web.Services.AccountRegistrationService Registration
@inject AccountEmailLinks Links

<PageTitle>@L["Create account · Ateliê Marylu"]</PageTitle>

<h1>@L["Create account"]</h1>

<div class="row">
    <div class="col-lg-6">
        <StatusMessage Message="@Message" />
        <GoogleButton ReturnUrl="@ReturnUrl" Divider="@L["or sign up with email and password"]" />
        <EditForm Model="Input" method="post" OnValidSubmit="RegisterUser" FormName="register">
            <LocalizedDataAnnotationsValidator />
            <p>@L["Almost there! Create your account to finish your purchase and follow your orders."]</p>
            <hr />
            <ValidationSummary class="text-danger" role="alert" />
            <div class="form-floating mb-3">
                <InputText @bind-Value="Input.FullName" id="Input.FullName" class="form-control" autocomplete="name" aria-required="true" placeholder="@L["Your name"]" />
                <label for="Input.FullName">@L["Full name"]</label>
                <ValidationMessage For="() => Input.FullName" class="text-danger" />
            </div>
            <div class="form-floating mb-3">
                <InputText @bind-Value="Input.Phone" id="Input.Phone" class="form-control" autocomplete="tel" placeholder="(21) 99999-9999" />
                <label for="Input.Phone">@L["Phone / WhatsApp (optional)"]</label>
                <ValidationMessage For="() => Input.Phone" class="text-danger" />
            </div>
            <div class="form-floating mb-3">
                <InputText @bind-Value="Input.Email" id="Input.Email" class="form-control" autocomplete="username" aria-required="true" placeholder="name@example.com" />
                <label for="Input.Email">@L["Email"]</label>
                <ValidationMessage For="() => Input.Email" class="text-danger" />
            </div>
            <div class="form-floating mb-3">
                <InputText type="password" @bind-Value="Input.Password" id="Input.Password" class="form-control" autocomplete="new-password" aria-required="true" placeholder="@L["Password"]" />
                <label for="Input.Password">@L["Password"]</label>
                <ValidationMessage For="() => Input.Password" class="text-danger" />
            </div>
            <div class="form-floating mb-3">
                <InputText type="password" @bind-Value="Input.ConfirmPassword" id="Input.ConfirmPassword" class="form-control" autocomplete="new-password" aria-required="true" placeholder="@L["Password"]" />
                <label for="Input.ConfirmPassword">@L["Confirm your password"]</label>
                <ValidationMessage For="() => Input.ConfirmPassword" class="text-danger" />
            </div>
            @if (Turnstile.IsActive)
            {
                <div class="cf-turnstile mb-3" data-sitekey="@Turnstile.SiteKey"></div>
            }
            <p class="small text-secondary">@L["By creating an account you agree to"] <a href="terms-of-use" target="_blank">@L["the terms of use"]</a> @L["and"] <a href="privacy-policy" target="_blank">@L["the privacy policy"]</a>.</p>
            <button type="submit" class="w-100 btn btn-lg btn-primary">@L["Create account"]</button>
            <p class="mt-3">@L["Already have an account?"] <a href="@(NavigationManager.GetUriWithQueryParameters("Account/Login", new Dictionary<string, object?> { ["ReturnUrl"] = ReturnUrl }))">Entrar</a></p>
        </EditForm>
    </div>
</div>

@code {
    private IEnumerable<IdentityError>? identityErrors;

    [SupplyParameterFromForm]
    private InputModel Input { get; set; } = default!;

    [SupplyParameterFromQuery]
    private string? ReturnUrl { get; set; }

    // O prefixo "Error:" também é traduzido: o StatusMessage usa ele para pintar o aviso de vermelho
    private string? Message => identityErrors is null ? null : L["Error: {0}", string.Join(", ", identityErrors.Select(error => error.Description))].Value;

    protected override void OnInitialized()
    {
        Input ??= new();
    }

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    public async Task RegisterUser(EditContext editContext)
    {
        if (!await Turnstile.ValidateAsync(HttpContext.Request.Form[AtelieMarylu.Infrastructure.Integrations.Turnstile.FormField], HttpContext.Connection.RemoteIpAddress?.ToString()))
        {
            identityErrors = [new IdentityError { Description = L["Confirm that you are not a robot."] }];
            return;
        }

        var user = CreateUser();
        user.FullName = CustomerText.Normalize(Input.FullName);
        user.PhoneNumber = string.IsNullOrWhiteSpace(Input.Phone) ? null : Input.Phone.Trim();

        // A regra do e-mail já cadastrado (mensagem neutra + aviso ao dono) fica no AccountRegistrationService
        var result = await Registration.RegisterAsync(user, Input.Email, Input.Password,
            new RegistrationLinks(Links.StoreHome(), Links.ForgotPassword()));
        if (!result.Succeeded)
        {
            identityErrors = result.Errors;
            return;
        }

        await SignInManager.SignInAsync(user, isPersistent: false);
        RedirectManager.RedirectTo(ReturnUrl);
    }

    private ApplicationUser CreateUser()
    {
        try
        {
            return Activator.CreateInstance<ApplicationUser>();
        }
        catch (MissingMethodException ex)
        {
            throw new InvalidOperationException($"Can't create an instance of '{nameof(ApplicationUser)}'. " +
                $"Ensure that '{nameof(ApplicationUser)}' is not an abstract class and has a parameterless constructor.", ex);
        }
        catch (MemberAccessException ex)
        {
            throw new InvalidOperationException($"Can't create an instance of '{nameof(ApplicationUser)}'. " +
                $"Ensure that '{nameof(ApplicationUser)}' is not an abstract class and has a parameterless constructor.", ex);
        }
    }

    private sealed class InputModel
    {
        // Vai nos e-mails da loja: sem dígitos, link nem telefone (AML-0042)
        [Required(ErrorMessage = "Enter the name.")]
        [PersonName]
        [Display(Name = "Full name")]
        public string FullName { get; set; } = "";

        [OptionalPhone(ErrorMessage = "Invalid phone number.")]
        [StringLength(20)]
        [Display(Name = "Phone")]
        public string? Phone { get; set; }

        [Required(ErrorMessage = "Enter your email.")]
        [EmailAddress(ErrorMessage = "Invalid email.")]
        [Display(Name = "Email")]
        public string Email { get; set; } = "";

        [Required(ErrorMessage = "Enter your password.")]
        [StringLength(100, ErrorMessage = "The password must be between 8 and 100 characters.", MinimumLength = 8)]
        [DataType(DataType.Password)]
        [Display(Name = "Password")]
        public string Password { get; set; } = "";

        [DataType(DataType.Password)]
        [Display(Name = "Confirm your password")]
        [Compare("Password", ErrorMessage = "The passwords do not match.")]
        public string ConfirmPassword { get; set; } = "";
    }
}
